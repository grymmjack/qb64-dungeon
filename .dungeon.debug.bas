DECLARE SUB Game_CutSetFlag (nm AS STRING, v AS DOUBLE)             ' write a persistent flag
DECLARE SUB Game_CutGrant (what AS STRING, amount AS DOUBLE)        ' gold / hp / item / key
DECLARE FUNCTION Game_CutArtPath$ (subpath AS STRING)                  ' pack-resolve an image
DECLARE FUNCTION Game_CutAudioPath$ (kind AS STRING, nm AS STRING)  ' pack-resolve audio
DECLARE SUB Game_CutMusic (path AS STRING, fadein AS SINGLE, doloop AS INTEGER)
DECLARE SUB Game_CutMusicStop (fade AS SINGLE)
DECLARE SUB Game_CutSfx (nm AS STRING)
DECLARE SUB Game_CutNarrate (k AS STRING)
DECLARE SUB Game_CutAudioTick                                       ' fades are frame-ticked



''
' DICE3D - Aggregated type/declaration includes.
' Include this once, near the top of your program (after OPTION _EXPLICIT).



''
' DICE3D - Configuration type + public enums
'
' One CONFIG struct drives an entire roll. It is passed by reference into
' dice3d_roll(). Fill it once with dice3d_config_defaults() then tweak fields.
' Every eventual feature has a field here already so the public API stays
' stable as later milestones light each one up.
'
' @author Rick Christy <grymmjack@gmail.com>

'--- Material styles -----------------------------------------------------------
CONST DICE3D_MAT_SOLID = 0
CONST DICE3D_MAT_CRYSTAL = 1
CONST DICE3D_MAT_MARBLE = 2
CONST DICE3D_MAT_NOISE = 3

'--- D6 pip styles -------------------------------------------------------------
CONST DICE3D_PIP_DOT = 0
CONST DICE3D_PIP_SQUARE = 1
CONST DICE3D_PIP_SPRITE = 2

'--- Drop effect ---------------------------------------------------------------
CONST DICE3D_DROPFX_FADE = 0
CONST DICE3D_DROPFX_EXPLODE = 1

'--- Render backend ------------------------------------------------------------
CONST DICE3D_RENDER_SOFTWARE = 0
CONST DICE3D_RENDER_HARDWARE = 1

'--- Die roles (percentile d100 splits into a high + low die) ------------------
CONST DICE3D_ROLE_NORMAL = 0
CONST DICE3D_ROLE_PCT_HI = 1
CONST DICE3D_ROLE_PCT_LO = 2

TYPE DICE3D_CONFIG
    '--- Dice box: a top-down screen region, in pixels -------------------------
    BOX_X AS INTEGER
    BOX_Y AS INTEGER
    BOX_W AS INTEGER
    BOX_H AS INTEGER
    BOX_SHOW_OUTLINE AS INTEGER
    BOX_OUTLINE_KOLOR AS _UNSIGNED LONG
    BOX_SHOW_BACK AS INTEGER '           TRUE = opaque fill, FALSE = transparent overlay
    BOX_BACK_KOLOR AS _UNSIGNED LONG

    '--- Die appearance --------------------------------------------------------
    DIE_SIZE AS SINGLE '                 half-extent in box pixels (48 => ~96px die)
    CAM_TILT AS SINGLE '                 view pitch in degrees (0 = pure top-down)
    D4_LEAN AS SINGLE  '                 d4 read pose: degrees the value-base is tipped from
    '                                    square-on. NEGATIVE tips the base TOWARD the camera
    '                                    (you see a sliver of the bottom); POSITIVE tips it
    '                                    AWAY (the bottom is hidden and you see more of the
    '                                    upper faces). 0 = edge-on, which reads as a flat
    '                                    triangle and is the one thing to avoid.
    CAM_YAW AS SINGLE '                  view yaw in degrees (orbit left/right)
    FOV AS SINGLE '                      field of view in degrees (0 = orthographic)
    MATERIAL AS INTEGER
    BODY_KOLOR AS _UNSIGNED LONG
    NUM_KOLOR AS _UNSIGNED LONG
    EDGE_KOLOR AS _UNSIGNED LONG
    EDGE_TRANSPARENT AS INTEGER
    BEVEL AS SINGLE '                    0 = sharp .. 1 = very round
    NUMERIC AS INTEGER '                 TRUE = draw numbers on faces
    NUM_SCALE AS SINGLE '                number height as a fraction of the face tile
    FONT_HANDLE AS LONG '                _LOADFONT handle for antialiased numbers (0 = built-in)
    FONT_PX AS INTEGER '                 desired font size (metadata; saved in sets)
    '--- material parameters ---------------------------------------------------
    BODY_ALPHA AS SINGLE '               overall body opacity 0..1 (translucent bodies)
    TEX_OPACITY AS SINGLE '              marble/noise pattern strength vs flat body 0..1
    MARBLE_KOLOR AS _UNSIGNED LONG '     marble vein colour
    CRYSTAL_ALPHA AS SINGLE '            crystal transparency 0..1
    '--- directional (top) light -----------------------------------------------
    '   Shades each face by how much it faces the light (Lambert), so top-facing
    '   surfaces catch light and the die gains real 3D form. The light is in VIEW
    '   space (fixed to the top of the screen), so it reads as an overhead light
    '   whatever the camera yaw/tilt. Direction points FROM a surface TO the light.
    LIGHT_ENABLED AS INTEGER '           TRUE = apply directional shading
    LIGHT_X AS SINGLE '                  light direction (auto-normalised)
    LIGHT_Y AS SINGLE '                  +Y = from the top of the screen
    LIGHT_Z AS SINGLE '                  +Z = from the camera side
    LIGHT_AMBIENT AS SINGLE '            0..1 min brightness for faces facing away
    LIGHT_INTENSITY AS SINGLE '          0..1 shading strength (darkening amount)
    LIGHT_KOLOR AS _UNSIGNED LONG '      light colour: lit faces wash toward it (white = neutral).
    '                                    Tint scales with the colour's saturation, so white/grey
    '                                    stay pure brightness; a hue (torch, moonlight) tints.
    '--- wireframe overlay -----------------------------------------------------
    WIRE_ENABLED AS INTEGER
    WIRE_KOLOR AS _UNSIGNED LONG
    WIRE_OPACITY AS SINGLE '             0..1

    '--- D6 pips ---------------------------------------------------------------
    D6_PIPS AS INTEGER
    PIP_STYLE AS INTEGER
    PIP_SPRITE AS LONG '                 image handle used when PIP_STYLE = SPRITE

    '--- Custom face sprite sheet (per-value overrides) ------------------------
    FACE_SHEET AS LONG
    FACE_CELL_W AS INTEGER
    FACE_CELL_H AS INTEGER

    '--- Percentile (d100) per-die body colors --------------------------------
    PCT_HI_KOLOR AS _UNSIGNED LONG '     tens die
    PCT_LO_KOLOR AS _UNSIGNED LONG '     units die

    '--- Drop lowest -----------------------------------------------------------
    DROP_LOWEST AS INTEGER '             count of lowest dice to drop
    DROP_FX AS INTEGER

    '--- Sound (handles come from _SNDOPEN in the caller) ----------------------
    SOUND_ENABLED AS INTEGER
    SND_EDGE_H AS LONG
    SND_SETTLE_H AS LONG

    '--- Animation / physics feel ----------------------------------------------
    RENDER_MODE AS INTEGER
    FPS AS INTEGER
    MAX_ROLL_SECS AS SINGLE '            safety cap so a roll always returns
    GRAVITY AS SINGLE
    RESTITUTION AS SINGLE '              wall/floor bounciness 0..1
    FRICTION AS SINGLE '                 spin/velocity damping per frame 0..1
    SPIN_STRENGTH AS SINGLE '            initial tumble speed (deg/frame magnitude)
    THROW_STRENGTH AS SINGLE '           initial scatter/shake velocity (px/frame)
END TYPE

''
' Parsed dice notation: "XdY" plus optional modifiers
'   dlN drop lowest N   dhN drop highest N   khN keep highest N   klN keep lowest N
'   +N / -N flat modifier   (e.g. "4d6dl1", "2d20kh1+3")
TYPE DICE3D_SPEC
    CNT AS INTEGER
    SIDES AS INTEGER
    DROP_LOW AS INTEGER
    DROP_HIGH AS INTEGER
    FLATMOD AS INTEGER
END TYPE



''
' DICE3D - Core types + engine-global state
'
' Orientation is a unit quaternion so any polyhedron face can be snapped to the
' camera with a clean slerp. Meshes are generated generically from a vertex list
' (see _GEO.BM), so one pipeline serves D4..D20.
'
' @author Rick Christy <grymmjack@gmail.com>

TYPE DICE3D_VEC3
    X AS SINGLE
    Y AS SINGLE
    Z AS SINGLE
END TYPE

TYPE DICE3D_QUAT
    W AS SINGLE
    X AS SINGLE
    Y AS SINGLE
    Z AS SINGLE
END TYPE

''
' One physical die instance for the duration of a roll.
TYPE DICE3D_DIE
    SIDES AS INTEGER
    VALUE AS INTEGER
    '--- orientation (quaternion) + angular velocity (deg/frame vector) ---
    Q AS DICE3D_QUAT
    WX AS SINGLE
    WY AS SINGLE
    WZ AS SINGLE
    '--- position in box pixels (center) + height, and velocity ---
    PX AS SINGLE
    PY AS SINGLE
    PZ AS SINGLE
    VX AS SINGLE
    VY AS SINGLE
    VZ AS SINGLE
    '--- settle state ---
    SETTLED AS INTEGER
    SETTLING AS INTEGER
    SLOW_FRAMES AS INTEGER
    HIT_WALL AS INTEGER
    TQ AS DICE3D_QUAT '                  target orientation for the rolled VALUE
    '--- drop-lowest FX ---
    DROPPED AS INTEGER
    FADE AS SINGLE '                     1 = fully visible .. 0 = gone
    DROP_T AS SINGLE '                   drop FX progress 0..1
    '--- misc ---
    ROLE AS INTEGER '                    DICE3D_ROLE_*
    BODY_KOLOR AS _UNSIGNED LONG '       per-die body override (percentile hi/lo)
    ATLAS AS LONG '                      baked face texture handle
    OFFSET AS INTEGER '                  atlas tile row offset (for shared atlases)
    HELD AS INTEGER '                    pinned by dice3d_hold: keeps its seat + face, no physics
END TYPE

'--- Engine globals ------------------------------------------------------------
DIM SHARED DICE3D_BOXBUF AS LONG '        off-screen 32-bit box compositing buffer
REDIM SHARED DICE3D_DICE(0) AS DICE3D_DIE

'--- HELD DICE -----------------------------------------------------------------
' A die can be PINNED for the next roll: it keeps the seat and the face it had, sits out the
' physics, and is not re-read. The rest of the tray tumbles around it.
'
' This is what a partial re-roll actually looks like on a table -- you pick up the dice you are
' re-throwing and leave the others where they lie. Rolling only the chosen dice in a fresh tray
' is a different picture: the kept dice vanish, and what the player sees stops matching the rule
' they chose ("re-roll the 1s and 2s" became "here are two dice, no idea why").
'
' Contract: call dice3d_hold BEFORE dice3d_roll, once per pinned die, 1-based to match the
' results() array. Holds are consumed by that roll and cleared. A hold is honoured only if the
' PREVIOUS roll had a die at that index to inherit a position from -- otherwise there is no
' "in place" to hold, and it simply rolls.
CONST DICE3D_HOLD_MAX = 16
DIM SHARED DICE3D_HOLD_ON AS INTEGER '    any holds pending for the next roll
DIM SHARED DICE3D_HOLD_V(1 TO DICE3D_HOLD_MAX) AS INTEGER '  per index: pinned value (0 = free)
REDIM SHARED DICE3D_PREV(0) AS DICE3D_DIE '  the previous roll's dice, for seats + poses
DIM SHARED DICE3D_PREV_N AS INTEGER

'--- painter order for the dice themselves (see dice3d_depth_order) ---------------
' SHARED rather than a local in the renderer: arrays here are dynamic, so a DIM inside a SUB that
' runs every frame is a Duplicate definition on the second call.
REDIM SHARED DICE3D_ORD(0) AS INTEGER
DIM SHARED DICE3D_ORD_N AS INTEGER

'--- Current mesh (shared by all dice of one type in a single roll) ------------
DIM SHARED DICE3D_NV AS INTEGER '         unique vertex count
REDIM SHARED DICE3D_MV(0) AS DICE3D_VEC3 ' model-space vertices (unit-ish)
DIM SHARED DICE3D_NT AS INTEGER '         triangle count
REDIM SHARED DICE3D_TA(0) AS INTEGER '    triangle vertex indices
REDIM SHARED DICE3D_TB(0) AS INTEGER
REDIM SHARED DICE3D_TC(0) AS INTEGER
REDIM SHARED DICE3D_TUX(0, 2) AS SINGLE ' per-triangle-vertex atlas UVs (pixels)
REDIM SHARED DICE3D_TUY(0, 2) AS SINGLE
REDIM SHARED DICE3D_TFACE(0) AS INTEGER ' logical face id per triangle

'--- Per-face data -------------------------------------------------------------
DIM SHARED DICE3D_NF AS INTEGER '         face count (= sides)
REDIM SHARED DICE3D_FACE_Q(0) AS DICE3D_QUAT '  "this face at camera" pose
REDIM SHARED DICE3D_FACE_N(0) AS DICE3D_VEC3 '  outward face normal (model space)
REDIM SHARED DICE3D_FACE_VAL(0) AS INTEGER '    numeric value on each face
' inradius/maxab per face: how much room the SHAPE gives a numeral once fitted to its tile.
' ~0.5 for a triangle, ~0.71 a square, ~0.81 a pentagon. The atlas scales numerals by it so
' the same digit reads the same size on every die (see dice3d_make_atlas).
REDIM SHARED DICE3D_FACE_ROOM(0) AS SINGLE
REDIM SHARED DICE3D_FACE_LABEL(0) AS STRING '   text stamped on each face
REDIM SHARED DICE3D_VAL2FACE(0) AS INTEGER '    value -> face index
REDIM SHARED DICE3D_CORNERVAL(0, 2) AS INTEGER '  D4 top-read: value at each triangle corner
REDIM SHARED DICE3D_FVN(0) AS INTEGER '         vertex count of each face polygon
REDIM SHARED DICE3D_FVIDX(0, 7) AS INTEGER '    ordered polygon vertex indices (for wireframe)

'--- Custom face sprite map: value -> sheet cell index (-1 = use number/pip) ---
REDIM SHARED DICE3D_FACE_CELL_MAP(0 TO 128) AS INTEGER
DIM SHARED DICE3D_FACE_MAP_READY AS INTEGER

'--- Result of the most recent roll -------------------------------------------
DIM SHARED DICE3D_LAST_TOTAL AS INTEGER '  sum of kept dice + flat modifier
DIM SHARED DICE3D_LAST_COUNT AS INTEGER '  number of result entries
DIM SHARED DICE3D_LAST_SIDES AS INTEGER '  die type rolled (100 = percentile)
REDIM SHARED DICE3D_LAST_VALUE(0) AS INTEGER '   per-entry value (1-based)
REDIM SHARED DICE3D_LAST_DROPPED(0) AS INTEGER '  per-entry dropped flag (1-based)

'--- Optional supersample anti-aliasing: render the box buffer at N x the on-screen
'    size, then smooth-downscale in dice3d_present. 0/1 = off. The caller sizes the
'    box (BOX_W/H, DIE_SIZE, physics) at N x and sets BOX_X/Y to the on-screen origin.
DIM SHARED DICE3D_SSDIV AS INTEGER

'--- Optional readable-result showcase: after the physics settle, turn each die so its
'    winning face is flat-on with the number UPRIGHT (physics can leave it sideways or
'    upside-down). 0 = off (pure physics rest). Set by the caller before dice3d_roll.
DIM SHARED DICE3D_UPRIGHT AS INTEGER

'--- Optional HARDWARE render: present the dice via 3D _MAPTRIANGLE on the OpenGL layer
'    (native display resolution, hardware texture filtering = genuinely smooth, unaffected
'    by any software-canvas fullscreen scaling). The caller draws the tray/background on
'    the software screen, sets these params + a hardware-copy atlas, then rolls. 0 = the
'    software box-buffer renderer. present() branches on this.
DIM SHARED DICE3D_HW AS INTEGER
' DEV: force the SOFTWARE renderer even where the game would pick hardware. The GL layer draws
' to the WINDOW, after the canvas blit, so _SAVEIMAGE CANVAS cannot see it -- a headless capture
' of a 3D roll would show an empty tray. The software renderer composites into the canvas, so it
' is the only path a dev-mode screenshot can prove. Set by `dungeon.run rollshot`; never in play.
DIM SHARED dice3d_force_soft AS INTEGER
DIM SHARED DICE3D_HWATLAS AS LONG   ' hardware (_COPYIMAGE ,33) atlas; built lazily, freed by the caller
DIM SHARED DICE3D_HL AS LONG        ' hardware white sheen tile for the read-face highlight (built lazily)
DIM SHARED DICE3D_HL_SW AS LONG     ' software white sheen tile (software render path)

'--- Directional-light shading: baked into the atlas as opaque brightness COLUMNS (see
'    dice3d_make_atlas). Column 0 = full bright, column NLEV-1 = darkest (MAXDARK black over
'    it). The renderer picks a per-face level and offsets the source U by level*DICE3D_TILE.
'    Opaque pixels only -- NO translucent overlays, which some GL drivers drop when a
'    semi-transparent tile is uploaded via _COPYIMAGE(,33) (they render invisible).
CONST DICE3D_LIGHT_NLEV = 12 '      brightness columns (finer = smoother gradient across a rounded bevel)
CONST DICE3D_LIGHT_MAXDARK = .62
CONST DICE3D_LIGHT_TINT = .55 '     max colour wash on the most-lit column (scaled by LIGHT_KOLOR saturation)
DIM SHARED DICE3D_HW_S AS SINGLE    ' GPU units per model unit (die on-screen size)
DIM SHARED DICE3D_HW_Z AS SINGLE    ' base view depth (negative; ~-5)
DIM SHARED DICE3D_HW_CX AS SINGLE   ' GPU x of the tray centre (0 = screen centre)
DIM SHARED DICE3D_HW_CY AS SINGLE   ' GPU y of the tray centre (0 = screen centre; +up)
DIM SHARED DICE3D_HW_PXK AS SINGLE  ' GPU units per box-pixel (maps die scatter positions)

'--- Fallback sound: when SOUND_ENABLED but no SND_EDGE_H / SND_SETTLE_H file is given,
'    the physics plays built-in tone beeps/boops at this volume (0..1). 0 = silent fallback.
DIM SHARED DICE3D_SND_VOL AS SINGLE

'--- Optional atlas resolution override: bake the face texture at this DIE_SIZE (px) even
'    if the die renders smaller (e.g. hardware dice render small but want a crisp hi-res
'    atlas so numbers stay sharp). 0 = bake at the config's DIE_SIZE.
DIM SHARED DICE3D_ATLAS_DIE AS SINGLE

'--- Geometric edge bevel (rounded dice): 0 = sharp polyhedron (original mesh). > 0 insets each
'    numbered face toward its centroid by this fraction and fills the frame with real bevel-strip
'    + vertex-cap geometry, so the EDGES are physically chamfered (not a texture trick). Set by
'    the caller before dice3d_build (it rebuilds the mesh). ~0.12-0.22 reads as a nice round. ---
DIM SHARED DICE3D_BEVEL AS SINGLE

'--- Optional frame capture (debugging / recording; 0 = off) -------------------
DIM SHARED DICE3D_SHOT_EVERY AS INTEGER '  save box buffer every N frames
DIM SHARED DICE3D_SHOT_DIR AS STRING
DIM SHARED DICE3D_FRAME AS LONG




'' DICE3D_GAME.bi -- dungeon-side globals for the 3D dice.
'  Included right AFTER include/DICE3D/_ALL.BI, since these arrays use DICE3D_CONFIG.
'  DSET3D / MSET3D are 7-slot dice sets (d4 d6 d8 d10 d12 d20 d100), indexed by
'  dice3d_set_index%(sides). Loaded from assets/data/diceset*.txt (see DICE3D_GAME.bas).

DIM SHARED DSET3D(0 TO 6) AS DICE3D_CONFIG   ' the player's 3D dice set
DIM SHARED MSET3D(0 TO 6) AS DICE3D_CONFIG   ' the monster's 3D dice set
DIM SHARED dice3d_ready AS INTEGER           ' TRUE once a set loaded OK (else 3D silently falls back to font dice)
' the selectable dice-set manifest (assets/data/dicesets.txt): display name + file
DIM SHARED DSET_NAME(1 TO 40) AS STRING, DSET_FILE(1 TO 40) AS STRING, DSET_COUNT AS INTEGER
' cached SETTINGS preview images (a static readable d20 per side), rebuilt on set change
DIM SHARED PREV3D_P AS LONG, PREV3D_M AS LONG
