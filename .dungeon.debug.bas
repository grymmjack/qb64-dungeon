CANVAS      = _NEWIMAGE(SW * CW, SH * CH, 32)
CANVAS_COPY = _NEWIMAGE(SW * CW, SH * CH, 32)
FULL_BOARD  = _NEWIMAGE(SW * CW, SH * CH, 32)
