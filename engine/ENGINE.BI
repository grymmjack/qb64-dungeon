' ============================================================================
'  ENGINE.BI -- reusable ENGINE globals / TYPEs / CONSTs (ANSI-art game runtime)
'  Split out of the old include/DUNGEON.BI. Included FIRST (game/GAME.BI second).
'
'  NORTH STAR: a *separable* engine -- this header should eventually name NO
'  game-specific symbol, and engine code should reach game logic only through
'  Game_* hooks. Remaining engine->game leaks are tracked in engine/ENGINE.md
'  (the boundary-debt ledger). Everything here is Dungeon!-agnostic machinery.
' ============================================================================

' --- generic state machine + loop contract ---
CONST ST_INTRO = 0, ST_MENU = 1, ST_PLAY = 2, ST_WIN = 3, ST_LOSE = 4, ST_QUIT = 5
CONST MENU_ENTER = 1, MENU_FLEE = 2
CONST OUT_WIN = 1, OUT_LOSE = 2, OUT_FLEE = 3   ' the play loop's return contract

' -- optional PIXEL-ART layer (assets/pixel-art/, generated by ~/pixelmon). Complements the
'    ANSI board with sprite portraits in panels (combat, character sheet). Graceful if missing. --
DIM SHARED SPR_PATH(1 TO 200) AS STRING   ' loaded-sprite cache: path -> image handle (0 = missing)
DIM SHARED SPR_H(1 TO 200) AS LONG
DIM SHARED SPR_N AS INTEGER

' --- the cursor / player token ---
TYPE CURSOR
    x            AS INTEGER
    y            AS INTEGER
    prev_x       AS INTEGER
    prev_y       AS INTEGER
    cursor_color AS _UNSIGNED LONG
END TYPE

' --- screen grid, canvas + palette ---
DIM SHARED AS INTEGER SW, SH, CW, CH
DIM SHARED AS LONG CANVAS, CANVAS_COPY
DIM SHARED AS _UNSIGNED LONG YELLOW, BLACK, BROWN, BRIGHT_BLUE
DIM SHARED AS _UNSIGNED LONG WHITE, GREY, REDU, GREENU, YELLOWU, CYANU, BOXBG
DIM SHARED BOARD_ANSI AS STRING
DIM SHARED DOOROPEN(0 TO 131, 0 TO 60) AS INTEGER    ' cell -> TRUE once a door has been passed through (FOV: closed doors block sight)

' --- named screen LAYOUT regions (see engine/LAYOUT.bas) ---
' A screen described as DATA: named rectangles in character cells, so drawing code asks for
' a region by name instead of hardcoding coordinates. Each region carries its own cell size
' because one game can mix metrics -- the tactical fight screen is 132x100 on an 8x8 cell
' while the board is 132x51 on 8x16, both on the same 1056-wide canvas.
CONST LAY_MAX = 200
DIM SHARED LAY_N AS INTEGER
DIM SHARED LAY_NAME(1 TO LAY_MAX) AS STRING, LAY_KIND(1 TO LAY_MAX) AS STRING
DIM SHARED LAY_NOTE(1 TO LAY_MAX) AS STRING
DIM SHARED LAY_COL(1 TO LAY_MAX) AS INTEGER, LAY_ROW(1 TO LAY_MAX) AS INTEGER
DIM SHARED LAY_W(1 TO LAY_MAX) AS INTEGER, LAY_H(1 TO LAY_MAX) AS INTEGER
DIM SHARED LAY_CW(1 TO LAY_MAX) AS INTEGER, LAY_CH(1 TO LAY_MAX) AS INTEGER

' -- shared scratch buffer for the data-file loaders (see engine/DATA.bas) --
DIM SHARED DLINE(1 TO 600) AS STRING, DLINE_N AS INTEGER

' --- turn machinery (ENGINE, by design) ---
' Turn STRUCTURE is engine: how many steps remain, whose turn it is, whether a roll is
' owed. What a turn COSTS and what combat does with it are game rules. Today only game/
' and dungeon.bas fill these, so the ENGINE.BI hoarding audit would flag them as unused --
' they are RESERVED there on purpose, because the deeper tactical-combat screen in
' plans/PLANS.todo needs engine-side initiative + turn order and will consume them.
' See the allowlist in tests/audit-boundary.sh.
DIM SHARED AS INTEGER turn_num, steps_left, need_roll
DIM SHARED c AS CURSOR
DIM SHARED bnr_l2 AS STRING, bnr_bx1 AS INTEGER, bnr_bx2 AS INTEGER   ' last Banner's prompt line + box, for the keypress flash

' --- dice display state + DPoly polyhedron fonts ---
DIM SHARED die_a AS INTEGER, die_b AS INTEGER    ' last dice shown by RollDiceShow
' DPoly polyhedron die fonts, indexed BY SIDE COUNT: DFONT(20) is the d20 font.
' Loaded from assets/fonts/dpoly by InitDice; 0 = failed to load (falls back to
' the number tumbler). Each glyph IS a die face: 'A'+n draws the solid variant,
' 'a'+n the outline variant -- see DieGlyphCode / DrawFontDie.
DIM SHARED DFONT(1 TO 20) AS LONG
DIM SHARED DFROT AS LONG                          ' scratch image a die renders into, then rotate-blits (tumble spin)
CONST DFROT_W = 160, DFROT_H = 200               ' scratch size (fits a d20 @56pt + headroom for the top vertex)
DIM SHARED last_raw AS INTEGER                    ' last natural dice sum (before modifiers) from DoRoll

' --- board detection: secret + regular doors auto-detected from the ANSI art ---
DIM SHARED SD_X(1 TO 500) AS INTEGER, SD_Y(1 TO 500) AS INTEGER
DIM SHARED SD_FOUND(1 TO 500) AS INTEGER, SD_N AS INTEGER
DIM SHARED FULL_BOARD AS LONG                     ' pristine board (doors + secret rooms visible)
DIM SHARED SAVE_FILE AS STRING                    ' the save slot's path -- the GAME sets this at startup
'                                                   (was hardcoded in SAVEIO + SAVEGAME; parameterising it
'                                                    is what lets `savetest` round-trip without touching
'                                                    the player's real save)
CONST START_CX = 59, START_CY = 24                ' entrance cell: where the cursor starts on this board
DIM SHARED DOOR_X(1 TO 800) AS INTEGER, DOOR_Y(1 TO 800) AS INTEGER
DIM SHARED DOOR_STRONG(1 TO 800) AS _BYTE, DOOR_BROKEN(1 TO 800) AS _BYTE, DOOR_N AS INTEGER
' --- fog-of-war + line-of-sight + secret-region masks ---
DIM SHARED VIS(0 TO 131, 0 TO 60) AS _BYTE        ' 1 = cell currently revealed
DIM SHARED LOS_LIT(0 TO 131, 0 TO 60) AS _BYTE, LOS_SEEN(0 TO 131, 0 TO 60) AS _BYTE
DIM SHARED fov_cx AS INTEGER, fov_cy AS INTEGER   ' last position FOV was computed from
DIM SHARED DOORCELL(0 TO 131, 0 TO 60) AS _BYTE   ' 1 = a secret-door cell
DIM SHARED SECRET(0 TO 131, 0 TO 60) AS _BYTE     ' 1 = fogged (door-connected sealed cell)
DIM SHARED FOGHIDE(0 TO 131, 0 TO 60) AS _BYTE    ' 1 = force-blacked stray speck (fog-hide.txt; [~] tints it)
DIM SHARED MASKREG(0 TO 131, 0 TO 60) AS INTEGER  ' secret-mask region id per cell (0 = public); reveal-by-region
DIM SHARED MASK_ON AS INTEGER                     ' TRUE = fog driven by the hand-painted mask, not the flood
DIM SHARED DOOR_REGION(1 TO 500) AS INTEGER       ' which mask region each secret door opens
DIM SHARED MASKLVL(0 TO 255) AS INTEGER           ' nesting depth per region (1 = opened from public, 2 = secret-in-secret, ...)
DIM SHARED MASKCOL(0 TO 131, 0 TO 60) AS _UNSIGNED LONG   ' sampled mask colour per cell (region flood)
DIM SHARED CLI_COLOR AS INTEGER                   ' console (CLI-mode) colour output on/off; off strips pipe codes
DIM SHARED QX(0 TO 8000) AS INTEGER, QY(0 TO 8000) AS INTEGER   ' flood-fill queue

' --- audio PACKS / narration / art packs / music cues ---
' A subdir under assets/sfx/ or assets/music/ overrides the flat files (a "theme"). "" = flat main dir.
DIM SHARED opt_sfxpack AS STRING, opt_musicpack AS STRING
DIM SHARED SFXPACKS(0 TO 32) AS STRING, SFXPACK_N AS INTEGER      ' index 0 = "(main)" ("") ; 1..N = subdir names
DIM SHARED MUSICPACKS(0 TO 32) AS STRING, MUSICPACK_N AS INTEGER
DIM SHARED opt_narration AS INTEGER, opt_narrationpack AS STRING
DIM SHARED NARRPACKS(0 TO 32) AS STRING, NARRPACK_N AS INTEGER
' narration FREQUENCY: which tiers of narration are spoken (cumulative). 0 = Flavor only
' (rooms/chambers/ambient/win-lose), 1 = + Events (curios/traps), 2 = + Combat.
CONST NARR_FLAVOR = 0, NARR_EVENT = 1, NARR_COMBAT = 2
DIM SHARED opt_narrfreq AS INTEGER
DIM SHARED opt_artpack AS STRING
DIM SHARED ARTPACKS(0 TO 32) AS STRING, ARTPACK_N AS INTEGER
DIM SHARED opt_ansipack AS STRING                ' selected ANSI-art pack (assets/ansi-art/<pack>/); "default" = the base
DIM SHARED ANSIPACKS(0 TO 32) AS STRING, ANSIPACK_N AS INTEGER
DIM SHARED opt_datapack AS STRING                ' selected DATA pack (assets/data/<pack>/ + assets/flavor/<pack>/); "default" = base game content
DIM SHARED DATAPACKS(0 TO 32) AS STRING, DATAPACK_N AS INTEGER
DIM SHARED narr_handle AS LONG                    ' the currently-playing narration line (one at a time)
DIM SHARED narr_start AS DOUBLE                   ' TIMER when the current line began (envelope is wall-clock, not playhead)
DIM SHARED narr_len AS DOUBLE                     ' _SNDLEN of the current line, read once (0 = unknown -> no fade-out)
DIM SHARED narr_fadein AS SINGLE                  ' narration fade-IN seconds (a SHARP ramp that masks the record key-click)
DIM SHARED narr_fadeout AS SINGLE                 ' narration fade-OUT seconds (masks the click at the end)
DIM SHARED narr_curve AS SINGLE                   ' fade SHAPE exponent applied to the envelope (pack.conf FADECURVE=; <1 sharp, 1 linear, >1 gentle)
DIM SHARED narr_conf_pack AS STRING               ' which pack's pack.conf is loaded into narr_fade* (cache key)
DIM SHARED narr_conf_loaded AS INTEGER            ' -1 once the fade envelope has been read at least once
DIM SHARED music_cue_active AS INTEGER            ' a non-level cue is playing over the level music

' --- audio/video + dice + char-gen SETTINGS options (engine preferences) ---
DIM SHARED opt_music AS INTEGER, opt_sfx AS INTEGER, opt_showdice AS INTEGER, opt_fullscreen AS INTEGER
DIM SHARED opt_voice AS INTEGER                                    ' typewriter text "voice" blips on/off
DIM SHARED opt_musicvol AS INTEGER, opt_sfxvol AS INTEGER, opt_voicevol AS INTEGER  ' 0..10 volume sliders
DIM SHARED opt_realdice AS INTEGER    ' player rolls their own physical dice and types the result
DIM SHARED opt_dicemath AS INTEGER    ' TRUE: player adds modifiers; FALSE: the game adds them
DIM SHARED opt_heroicstats AS INTEGER ' TRUE: roll abilities 4d6-drop-lowest; FALSE: straight 3d6
DIM SHARED opt_fov AS INTEGER         ' TRUE: line-of-sight fog-of-war (explore the map)
' ---- dice look & feel (all persisted; see DiceColors / DrawFontDie) ----
DIM SHARED opt_dicecolor AS INTEGER   ' 0..5 index into the dice palette (Bone/Blood/Emerald/Sapphire/Gold/Amethyst)
DIM SHARED DICE_BODY(0 TO 5) AS _UNSIGNED LONG   ' dice palettes, from assets/data/dice-colors.txt
DIM SHARED DICE_INK(0 TO 5) AS _UNSIGNED LONG
DIM SHARED DICE_CNAME(0 TO 5) AS STRING
DIM SHARED STR_KEY(1 TO 400) AS STRING   ' UI string table (assets/data/strings.txt), Say$()
DIM SHARED STR_TXT(1 TO 400) AS STRING
DIM SHARED STR_N AS INTEGER
DIM SHARED opt_dicesolid AS INTEGER   ' TRUE: filled die body + contrasting number; FALSE: hollow outline
DIM SHARED opt_d6pips AS INTEGER      ' TRUE: d6 rolls use the hand-drawn pip dice; FALSE: the numbered DPoly d6
DIM SHARED opt_dicespeed AS INTEGER   ' tumble pacing: 0 Slow, 1 Normal, 2 Fast, 3 Instant (see DiceTiming)
DIM SHARED opt_dicelight AS INTEGER   ' 3D dice top-light: 0 Off, 1 Soft, 2 Normal, 3 Strong (ApplyDiceLight)
DIM SHARED opt_diceround AS INTEGER   ' 3D dice edge roundness 0 (sharp) .. 10 (very round); drives cfg.BEVEL
' -- a SEPARATE dice look for the "monster's" rolls (same options; swapped in around those rolls) --
DIM SHARED opt_mon_dicecolor AS INTEGER, opt_mon_dicesolid AS INTEGER
DIM SHARED opt_mon_d6pips AS INTEGER, opt_mon_dicespeed AS INTEGER
DIM SHARED sav_dicecolor AS INTEGER, sav_dicesolid AS INTEGER, sav_d6pips AS INTEGER, sav_dicespeed AS INTEGER
DIM SHARED opt_dice3d AS INTEGER, opt_mon_dice3d AS INTEGER, sav_dice3d AS INTEGER, dice3d_use_mon AS INTEGER
DIM SHARED DICE3D_YOFF AS INTEGER      ' rows to shift the 3D dice tray down (0 default)
DIM SHARED gauge_quality AS SINGLE     ' 0..1 closeness to dead-centre on the last gesture lock
DIM SHARED opt_juice AS INTEGER        ' SETTINGS "Screen Effects": hit-shake, blood/poison splatter, near-death vignette
DIM SHARED FX_BUF AS LONG              ' offscreen snapshot buffer for the screen-shake blit
' -- near-death blood-grime overlay (pre-baked once, stretched per frame) --
CONST NBLOOD = 64
DIM SHARED BLOOD_X(1 TO NBLOOD) AS INTEGER, BLOOD_Y(1 TO NBLOOD) AS INTEGER, BLOOD_R(1 TO NBLOOD) AS INTEGER
CONST NVIG = 10                        ' pre-baked soft RADIAL vignette overlays (a HP-ramp; stretched per frame)
DIM SHARED VIG(0 TO NVIG - 1) AS LONG
CONST BLOOD_ALPHA_MAX = 200            ' near-death blood-grime opacity at full strength (SETTINGS "Blood" scales it)
DIM SHARED opt_bloodstrength AS INTEGER ' SETTINGS "Blood": near-death blood-grime intensity 0 (none) .. 10 (max)
CONST NDRIP = 16                       ' blood drips running down from the top edge (near-death overlay)
DIM SHARED DRIP_X(1 TO NDRIP) AS INTEGER, DRIP_LEN(1 TO NDRIP) AS INTEGER, DRIP_W(1 TO NDRIP) AS INTEGER
' -- poison overlay bake data (veins + slime + ooze; drawn while a status timer is up) --
CONST NVEIN = 22                       ' poison vein/branch trunks (grown inward from the rim)
CONST NVEINSEG = 240                   ' pre-baked vein line segments (trunks + child branches)
DIM SHARED VEIN_X1(1 TO NVEINSEG) AS INTEGER, VEIN_Y1(1 TO NVEINSEG) AS INTEGER
DIM SHARED VEIN_X2(1 TO NVEINSEG) AS INTEGER, VEIN_Y2(1 TO NVEINSEG) AS INTEGER
DIM SHARED VEIN_GEN(1 TO NVEINSEG) AS INTEGER, VEIN_N AS INTEGER
CONST NSLIME = 48                      ' green slime blobs pooling around the frame
DIM SHARED SLIME_X(1 TO NSLIME) AS INTEGER, SLIME_Y(1 TO NSLIME) AS INTEGER, SLIME_R(1 TO NSLIME) AS INTEGER
CONST NOOZE = 14                       ' green ooze drips running down from the top edge
DIM SHARED OOZE_X(1 TO NOOZE) AS INTEGER, OOZE_LEN(1 TO NOOZE) AS INTEGER, OOZE_W(1 TO NOOZE) AS INTEGER
' -- configurable UI fonts (assets/data/ui-fonts.txt -> LoadUIFonts) --
DIM SHARED UIF_LABEL AS LONG, UIF_MSG AS LONG, UIF_COMBAT AS LONG, UIF_MENU AS LONG, UIF_HUD AS LONG
DIM SHARED opt_dice3d_set AS INTEGER, opt_mon_dice3d_set AS INTEGER   ' 1-based index into dicesets.txt
DIM SHARED opt_dicefont AS INTEGER    ' which numeral font (1-based index into dicefonts.txt)
DIM SHARED opt_smooth AS INTEGER      ' TRUE: bilinear-smoothed fullscreen; FALSE: crisp pixel-doubled
DIM SHARED opt_msgdelay AS INTEGER    ' auto-advance hold for banner messages: 1..5 seconds, or 0 = wait for a key
DIM SHARED SVTOK(1 TO 12000) AS STRING, SVTOK_N AS INTEGER, SVTOK_I AS INTEGER   ' save-file token stream
' --- active-character stat scaffolding (generic RPG stats; JUICE reads player_hp) ---
DIM SHARED player_hp AS INTEGER, player_maxhp AS INTEGER   ' adventurer hit points
DIM SHARED player_dmgdie AS INTEGER   ' weapon damage die (engine/GESTURE.bas CritFlourish% rolls it)
' --- music + sound-effect subsystem ---
CONST MUSIC_FADE_SEC = 2.5                        ' music fade/crossfade duration, seconds (hardcoded; fade-in from silence AND track-to-track)
CONST NARR_FADE_IN_DEF = .25                      ' default narration fade-in seconds -- a SHARP ramp (pack.conf FADEIN= overrides)
CONST NARR_FADE_OUT_DEF = .5                      ' default narration fade-out seconds (pack.conf FADEOUT= overrides)
CONST NARR_FADE_CURVE_DEF = .5                    ' default fade SHAPE exponent: <1 sharp/fast rise, 1 linear, >1 gentle (pack.conf FADECURVE=)
DIM SHARED music_handle AS LONG                  ' currently-looping menu/level music (for live volume)
DIM SHARED music_fadeout AS LONG                 ' the PREVIOUS track, crossfading out under a transition (0 = none)
DIM SHARED music_fade_start AS DOUBLE            ' TIMER when the current crossfade began
DIM SHARED music_fading AS INTEGER               ' -1 while a crossfade ramp is in progress
' --- audio MIXER: dedicated channels (music / voice / sfx), each auto-mixed by QB64.
'     Final volume per channel = player slider x channel gain x (duck / fade / envelope). ---
CONST CH_MUSIC = 0, CH_VOICE = 1, CH_SFX = 2     ' channel ids for ChannelGain
CONST DUCK_ATTACK = .06                           ' per-frame step to duck DOWN under voice (fast, ~0.15s)
CONST DUCK_RELEASE = .02                          ' per-frame step to restore UP after voice (gentle, ~0.5s)
DIM SHARED opt_duckamt AS INTEGER                 ' SETTINGS 0..10: how far music dips under narration (0 off, 10 = silent under voice)
DIM SHARED music_duck AS SINGLE                   ' live music duck multiplier (1 = open, dips toward 1-opt_duckamt/10 under voice)
DIM SHARED chgain_music AS SINGLE                 ' programmatic per-channel gain on TOP of the player's slider (1 = unity)
DIM SHARED chgain_voice AS SINGLE
DIM SHARED chgain_sfx AS SINGLE
DIM SHARED MUSIC_FILE(1 TO 9) AS STRING          ' music file assigned to each dungeon level (in assets/music/)
DIM SHARED music_level AS INTEGER                ' the level whose track is loaded right now (0 = none)
DIM SHARED music_curfile AS STRING               ' the file currently loaded (so same-file levels don't restart it)
DIM SHARED SFX_NAME(1 TO 48) AS STRING, SFX_HND(1 TO 48) AS LONG, SFX_N AS INTEGER
