' ============================================================================
'  ENGINE.BI -- reusable ENGINE globals / TYPEs / CONSTs (ANSI-art game runtime)
'  Split out of the old include/DUNGEON.BI. Included FIRST (game/GAME.BI second).
'
'  NORTH STAR: a *separable* engine -- this header should eventually name NO
'  game-specific symbol, and engine code should reach game logic only through
'  Game_* hooks. Remaining engine->game leaks are tracked in engine/ENGINE.md
'  (the boundary-debt ledger). Everything here is Dungeon!-agnostic machinery.
' ============================================================================

' --- generic state machine + loop contract ---
CONST ST_INTRO = 0, ST_MENU = 1, ST_PLAY = 2, ST_WIN = 3, ST_LOSE = 4, ST_QUIT = 5
CONST MENU_ENTER = 1, MENU_FLEE = 2
CONST OUT_WIN = 1, OUT_LOSE = 2, OUT_FLEE = 3   ' the play loop's return contract

' -- optional PIXEL-ART layer (assets/pixel-art/, generated by ~/pixelmon). Complements the
'    ANSI board with sprite portraits in panels (combat, character sheet). Graceful if missing. --
DIM SHARED SPR_PATH(1 TO 200) AS STRING   ' loaded-sprite cache: path -> image handle (0 = missing)
DIM SHARED SPR_H(1 TO 200) AS LONG
DIM SHARED SPR_N AS INTEGER

' --- the cursor / player token ---
TYPE CURSOR
    x            AS INTEGER
    y            AS INTEGER
    prev_x       AS INTEGER
    prev_y       AS INTEGER
    cursor_color AS _UNSIGNED LONG
END TYPE

' --- screen grid, canvas + palette ---
DIM SHARED AS INTEGER SW, SH, CW, CH
DIM SHARED AS LONG CANVAS, CANVAS_COPY
DIM SHARED AS _UNSIGNED LONG YELLOW, BLACK, BROWN, BRIGHT_BLUE
DIM SHARED AS _UNSIGNED LONG WHITE, GREY, REDU, GREENU, YELLOWU, CYANU, BOXBG
DIM SHARED BOARD_ANSI AS STRING
DIM SHARED DOOROPEN(0 TO 131, 0 TO 60) AS INTEGER    ' cell -> TRUE once a door has been passed through (FOV: closed doors block sight)
' Line of sight FORCED ON by where you are, regardless of the player's setting -- the game sets
' this (DUNGEON! does it on the 9th level, whose darkness is not optional). Kept SEPARATE from
' opt_fov because opt_fov is the player's saved preference and must survive being overridden:
' writing the override into the setting would persist it and silently change their config.
DIM SHARED fov_forced AS INTEGER

' --- NARRATION QUEUE -----------------------------------------------------------
' Narrate deliberately refuses to cut off a line that is still speaking, which is right for
' unrelated lines but makes COMPOSED speech impossible -- "Goblins" followed by "bar your path"
' is two clips, and the second would simply be dropped. The queue lets a caller line up a few
' short clips that are meant to be heard as one sentence; AudioTick starts the next when the
' current one ends. Kept tiny on purpose: this is for a name plus a line, not a monologue.
CONST NARRQ_MAX = 4
DIM SHARED NARRQ(1 TO NARRQ_MAX) AS STRING
DIM SHARED narrq_n AS INTEGER, narrq_i AS INTEGER

' What kind of room cell is at a board position -- see CellRoomKind% in engine/BOARD.bas.
' FLOOR is where a monster or a headstone belongs; DOOR is walkable but is a threshold, not a
' place to stand something; MIXED is the art's decorative half-block lip and is not walkable.
CONST CRK_NONE = 0
CONST CRK_FLOOR = 1
CONST CRK_DOOR = 2
CONST CRK_MIXED = 3
' Not a verdict CellRoomKind% ever returns -- roomlint's overlay tags ORPHAN cells with it:
' floor the art paints that never became a room at all (see OrphanBlockScan).
CONST CRK_ORPHAN = 4

' --- named screen LAYOUT regions (see engine/LAYOUT.bas) ---
' A screen described as DATA: named rectangles in character cells, so drawing code asks for
' a region by name instead of hardcoding coordinates. Each region carries its own cell size
' because one game can mix metrics -- the tactical fight screen is 132x100 on an 8x8 cell
' while the board is 132x51 on 8x16, both on the same 1056-wide canvas.
' --- composure GAUGE: the gesture model (see engine/GAUGE.bas) ---
' One record carries an attempt: the actor's condition (inputs), the knobs derived from
' it, and the live per-frame state. A renderer reads p/zc/ecrit/ehit and must draw the
' zone EXACTLY there -- WYSIWYG is sacred, per the design bible.
TYPE GAUGEK
    ' -- inputs: the actor's condition --
    skill     AS INTEGER   ' 0..2 felt tier (char_level maps in; a real skill system later)
    hp        AS INTEGER
    maxhp     AS INTEGER
    will      AS INTEGER   ' willpower presses left (spendable composure)
    willmax   AS INTEGER
    wobble    AS INTEGER   ' extra input degradation, 0..3 (drink and the like)
    press     AS INTEGER   ' engaged enemies beyond the first, 0..3 -- the 1-vs-4 squeeze
    depth     AS INTEGER   ' dungeon level 1..9
    ' -- derived knobs (GaugeKnobs) --
    crit      AS SINGLE    ' crit half-width, baseline
    hit       AS SINGLE    ' hit half-width, baseline
    speed     AS SINGLE    ' sweep speed
    jitter    AS SINGLE    ' per-attempt tempo variance
    wander    AS SINGLE    ' how far the sweet spot roams
    wprestore AS SINGLE    ' window regrowth per willpower press
    maxsweeps AS INTEGER   ' passes allowed to commit (0 = only the fuse bounds you)
    ' -- live state (GaugeBegin / GaugeStep) --
    phase     AS SINGLE
    phase0    AS SINGLE
    wphase    AS SINGLE
    sphase    AS SINGLE
    swspeed   AS SINGLE
    wspeed    AS SINGLE
    shake     AS SINGLE
    steady    AS SINGLE
    focus     AS SINGLE
    jitoff    AS SINGLE
    frame     AS INTEGER
    sweeps    AS INTEGER
    clutch    AS INTEGER   ' TRUE if the last score was a crit landed while vulnerable
    ' -- what a renderer draws and a scorer reads --
    p         AS SINGLE    ' marker position 0..1
    zc        AS SINGLE    ' zone centre 0..1
    ecrit     AS SINGLE    ' effective crit half-width THIS frame
    ehit      AS SINGLE    ' effective hit half-width THIS frame
END TYPE

' --- AUDIO FORMAT PRECEDENCE (SETTINGS row 53) ---------------------------------
' Which container wins when the SAME asset exists in several formats. This has to be the
' PLAYER's choice, not a hardcoded order: a pack that ships both .ogg and .flac would otherwise
' have half its files silently unreachable, and nothing on screen would say why.
'   0 = auto (ogg, mp3, flac, wav -- smallest-first, the historical order)
'   1 = ogg   2 = mp3   3 = flac   4 = wav      (the named one goes FIRST, rest follow in auto order)
' Tracker modules (.mid/.rad/.s3m/.mod/.xm/.it) always precede all of these for MUSIC -- they are
' a different kind of asset, not a container choice.
CONST AUDIOPREF_AUTO = 0
CONST AUDIOPREF_N = 4
DIM SHARED opt_audiopref AS INTEGER

' --- PER-CATEGORY FORMAT OVERRIDE ----------------------------------------------
' opt_audiopref above is the INHERITED order every category follows by default. These three
' override it for one category at a time, and the model is deliberately override-then-inherit,
' NOT a hard filter:
'
'     the explicit choice is tried FIRST; if it yields nothing, the inherited ladder runs.
'
' So picking FLAC for music does not silence a pack that only ships .ogg -- it means "give me the
' FLAC when there is one". A hard filter would make a partial pack go quiet with nothing on
' screen explaining why, which is the same trap the pack fallback already avoids per-file.
'
' FMT_OGG..FMT_WAV deliberately share AUDIOPREF's 1..4 numbering, so the two settings cannot
' disagree about what "2" means.
CONST FMT_INHERIT = 0
CONST FMT_OGG = 1
CONST FMT_MP3 = 2
CONST FMT_FLAC = 3
CONST FMT_WAV = 4
CONST FMT_TRACKER = 5              ' .mid/.rad/.s3m/.mod/.xm/.it -- MUSIC only (a different kind of asset)
CONST FMT_BEEP = 6                 ' SFX only: skip files entirely and use the hand-tuned Tone fallbacks
CONST AUDCAT_MUSIC = 1
CONST AUDCAT_SFX = 2
CONST AUDCAT_NARR = 3
DIM SHARED opt_fmt_music AS INTEGER, opt_fmt_sfx AS INTEGER, opt_fmt_narr AS INTEGER

' --- TACTICAL COMBAT tuning (assets/data/tuning.txt) ---------------------------
' Stored as INTEGERS because that is what LoadTuning reads -- so sub-second values are in
' MILLISECONDS and percentages are whole percents.
'
' Each is an OVERRIDE, not the value itself: zero means "use the built-in default" (the CONSTs
' below and in FUSE.bas). That matters because examples/minimal drives the engine WITHOUT the
' game, so it never calls LoadTuning -- reading these directly would hand it a 0-second reaction
' window. It also makes the load order irrelevant: no init call has to run before or after
' LoadTuning to get sane numbers.
DIM SHARED TUNE_FUSE_MIN_MS AS INTEGER      ' floor on any attack fuse
DIM SHARED TUNE_GESTURE_MS AS INTEGER       ' the player's commit deadline on a gesture
DIM SHARED TUNE_DODGE_MS AS INTEGER         ' window to answer an incoming blow's arrow
DIM SHARED TUNE_FUSE_BASE_MS AS INTEGER     ' fuse length at tier 0 / depth 1
DIM SHARED TUNE_FUSE_TIER_MS AS INTEGER     ' subtracted per menace tier
DIM SHARED TUNE_FUSE_DEPTH_MS AS INTEGER    ' subtracted per dungeon level
DIM SHARED TUNE_ST_ATK_OUT AS INTEGER, TUNE_ST_ATK_IN AS INTEGER   ' stance damage scaling, %
DIM SHARED TUNE_ST_GRD_OUT AS INTEGER, TUNE_ST_GRD_IN AS INTEGER
DIM SHARED TUNE_ST_STG_OUT AS INTEGER, TUNE_ST_STG_IN AS INTEGER
' (health-tier thresholds live in game/GAME.BI -- only the game's HealthWord$ reads them)

CONST GESTURE_FUSE = 1.7          ' action-gesture countdown, seconds -- tight: about one good sweep
CONST DODGE_WINDOW = 0.85         ' seconds to answer an incoming blow's arrow prompt --
'                                   short enough to be a reflex, long enough to be fair
CONST GAUGE_BASE_Q = 0.5          ' quality of a PLAIN (no-gesture) attack: mid-band, so it reads
'                                   as "solid but unremarkable". The opt-in gesture is then a
'                                   gamble around it -- see the dominance note in GAUGE.bas.
CONST LAY_MAX = 200
DIM SHARED LAY_N AS INTEGER
DIM SHARED LAY_NAME(1 TO LAY_MAX) AS STRING, LAY_KIND(1 TO LAY_MAX) AS STRING
DIM SHARED LAY_NOTE(1 TO LAY_MAX) AS STRING
DIM SHARED LAY_COL(1 TO LAY_MAX) AS INTEGER, LAY_ROW(1 TO LAY_MAX) AS INTEGER
DIM SHARED LAY_W(1 TO LAY_MAX) AS INTEGER, LAY_H(1 TO LAY_MAX) AS INTEGER
DIM SHARED LAY_CW(1 TO LAY_MAX) AS INTEGER, LAY_CH(1 TO LAY_MAX) AS INTEGER

' --- tactical-combat actors (engine/FIGHT.bas) --------------------------------
' Slot 0 is ALWAYS the player, 1..FIGHT_MAXFOE are the foes. That indexing is the whole
' trick behind the renderer: slot 0 draws into the "player.*" layout regions and slot n
' draws into "enemy<n>.*", so ONE loop paints every actor and the player is not a special
' case with its own duplicated draw code.
'
' The stat/status rows are deliberately GENERIC label+value pairs rather than named
' melee/ranged/armor fields. The engine renders "three label: value rows in this region";
' what they SAY is the game's business (DUNGEON! puts MELEE/RANGED/ARMOR and
' HEALTH/STANCE/EFFECT there). A different game on this engine can put anything in them
' without touching the renderer -- the reason FIGHT.bas can stay game-free at all.
'
' Parallel arrays rather than a UDT because QB64 UDTs cannot contain arrays, and the
' renderer wants `FOR r = 1 TO FIGHT_STATROWS`. Same shape as LAY_* above.
CONST FIGHT_MAXFOE = 4
CONST FIGHT_STATROWS = 3
CONST FIGHT_LOGMAX = 64
DIM SHARED FA_USED(0 TO FIGHT_MAXFOE) AS INTEGER      ' slot occupied at all
DIM SHARED FA_ALIVE(0 TO FIGHT_MAXFOE) AS INTEGER     ' occupied but dead -> drawn as a corpse
DIM SHARED FA_NAME(0 TO FIGHT_MAXFOE) AS STRING
DIM SHARED FA_SUB(0 TO FIGHT_MAXFOE) AS STRING        ' "1st Level Fighter" / a monster's level line
DIM SHARED FA_ART(0 TO FIGHT_MAXFOE) AS STRING        ' art basename, e.g. "monsters/goblin"
' A FULLY-RESOLVED fallback image path the game may supply per actor, tried after the
' fight-sized art. It exists because resolving general art needs game knowledge the engine
' does not have: DUNGEON! files monsters under category subfolders (monsters/beasts/wolf.png)
' and falls back to event props for a mimic. That taxonomy is the game's, so the game resolves
' it (MonsterSprite$/ClassSprite$/TreasureSprite$) and hands over a path -- rather than the
' engine learning what a "beast" is, or a hook being invented for one string.
DIM SHARED FA_ART2(0 TO FIGHT_MAXFOE) AS STRING
DIM SHARED FA_HP(0 TO FIGHT_MAXFOE) AS INTEGER, FA_MAXHP(0 TO FIGHT_MAXFOE) AS INTEGER
DIM SHARED FA_LAB(0 TO FIGHT_MAXFOE, 1 TO FIGHT_STATROWS) AS STRING
DIM SHARED FA_VAL(0 TO FIGHT_MAXFOE, 1 TO FIGHT_STATROWS) AS STRING
DIM SHARED FA_SLAB(0 TO FIGHT_MAXFOE, 1 TO FIGHT_STATROWS) AS STRING
DIM SHARED FA_SVAL(0 TO FIGHT_MAXFOE, 1 TO FIGHT_STATROWS) AS STRING
DIM SHARED FA_FUSE(0 TO FIGHT_MAXFOE) AS SINGLE       ' 0..1 fill of that actor's gauge bar
' Gore colour for this actor's portrait, 0 = never splatter (the engine has no idea which
' creatures bleed, or what colour -- the GAME sets it via FightSetGore; see GoreColor~&).
DIM SHARED FA_GORE(0 TO FIGHT_MAXFOE) AS _UNSIGNED LONG
DIM SHARED FA_TARGET AS INTEGER                       ' which foe slot is selected (0 = none)
DIM SHARED FIGHT_ROUND AS INTEGER, FIGHT_INIT AS STRING
DIM SHARED FIGHT_BANNER AS STRING
DIM SHARED FLOG(1 TO FIGHT_LOGMAX) AS STRING, FLOG_MARK(1 TO FIGHT_LOGMAX) AS STRING
DIM SHARED FLOG_N AS INTEGER
DIM SHARED FIGHT_LAYOUT_OK AS INTEGER                 ' the layout file loaded; 0 = cannot draw
DIM SHARED FIGHT_CHROME AS INTEGER                    ' authored frame.ans was drawn this frame

' The action menu, as GENERIC strings the renderer draws -- same reasoning as the stat rows.
' The engine paints "a horizontal row of labels with one highlighted"; what the labels SAY and
' what choosing one does are entirely the game's business. Keeping it here rather than letting
' the game draw over the screen afterwards means the 8x8 font bracket stays in ONE place
' (FightRender), instead of every caller having to remember to re-enter and restore it.
CONST FIGHT_MENUMAX = 8
CONST MENU_ROWS = 2               ' rows the root action menu may wrap across before
'                                   it would run down over the player portrait
DIM SHARED FMENU(1 TO FIGHT_MENUMAX) AS STRING, FMENU_N AS INTEGER, FMENU_SEL AS INTEGER
DIM SHARED FMENU_SUB(1 TO FIGHT_MENUMAX) AS STRING, FMENU_SUBN AS INTEGER
DIM SHARED FMENU_HINT AS STRING

' --- per-actor STATUS effects (engine/STATUS.bas) ------------------------------
' Poison, bleed, frost, stun -- whatever the game names them. The engine tracks DURATION and
' applies DAMAGE OVER TIME; what a label MEANS is the game's business, exactly like the generic
' stat rows. Same actor indexing as FIGHT.bas (0 = player, 1..4 = foes).
'
' Durations are in SECONDS, not turns, because the tactical fight is real-time -- the fuses are
' seconds and a status measured in "turns" would have no defined length while the player sits in
' the menu.
'
' FS_ACC is the reason this needs care: at 60fps a 2-damage-per-second poison deals 0.033 per
' frame, and INT() of that is ZERO -- a naive implementation ticks forever and never hurts
' anyone. The fractional remainder is carried in FS_ACC and paid out in whole points, so a 2 dps
' poison over 3 seconds deals exactly 6 regardless of frame rate.
CONST FSTAT_MAX = 4               ' concurrent effects per actor
DIM SHARED FS_KIND(0 TO FIGHT_MAXFOE, 1 TO FSTAT_MAX) AS STRING
DIM SHARED FS_SECS(0 TO FIGHT_MAXFOE, 1 TO FSTAT_MAX) AS SINGLE   ' remaining, 0 = empty slot
DIM SHARED FS_DPS(0 TO FIGHT_MAXFOE, 1 TO FSTAT_MAX) AS SINGLE    ' damage per second (0 = none)
DIM SHARED FS_ACC(0 TO FIGHT_MAXFOE, 1 TO FSTAT_MAX) AS SINGLE    ' fractional damage carry
DIM SHARED FS_MOD(0 TO FIGHT_MAXFOE, 1 TO FSTAT_MAX) AS INTEGER   ' +/- to the actor's effectiveness

' --- STANCES. A stance is a MECHANICAL state, not a caption: it modifies damage dealt and
' taken, and the renderer happens to show its name. Kept as small integers with one lookup, so a
' stance can never be set to a string nothing checks for.
CONST STANCE_READY = 0
CONST STANCE_ATTACK = 1           ' committed: more damage dealt, more taken
CONST STANCE_GUARD = 2            ' braced: less taken, less dealt
CONST STANCE_STAGGER = 3          ' off balance: takes more, deals less, cannot guard
DIM SHARED FA_STANCE(0 TO FIGHT_MAXFOE) AS INTEGER

' --- parallel attack FUSES (engine/FUSE.bas) ----------------------------------
' The tactical layer: every foe runs its OWN countdown, all at the same time, and the player
' triages -- drop the one about to fire, or race it to kill the big one first. Crucially the
' fuses ADVANCE WHILE THE PLAYER DELIBERATES (greywood's pacing fix): stand there reading the
' menu and something seizes the opening. That is the whole source of pressure in a 1-vs-4.
'
' Kept as PURE STATE + PURE STEPS, deliberately separate from FIGHT.bas's renderer, so the
' model is unit-testable with no display (tests/TEST-FUSE.bas) -- the same split that made
' GAUGE.bas testable. FuseStep mirrors its result into FA_FUSE() so the renderer needs no
' knowledge of any of this.
'
' Slot 0 (the player) uses the same arrays: the player's fuse is the COMMIT DEADLINE while a
' gesture is up. One mechanism, so "you ran out of time" works identically for both sides.
CONST FUSE_MIN = 0.9              ' seconds -- the shortest a fuse may ever be, so there is
'                                   ALWAYS a reaction window. Without a floor, deep levels
'                                   would produce unavoidable hits, which reads as a bug.
CONST FUSE_NONE = -1              ' "no slot" -- 0 is a real slot (the player), so not 0
DIM SHARED FF_T(0 TO FIGHT_MAXFOE) AS SINGLE      ' seconds accumulated on this fuse
DIM SHARED FF_DUR(0 TO FIGHT_MAXFOE) AS SINGLE    ' seconds this fuse runs for in total
DIM SHARED FF_ARMED(0 TO FIGHT_MAXFOE) AS INTEGER ' counting down right now
DIM SHARED FF_PEND(0 TO FIGHT_MAXFOE) AS INTEGER  ' completed; the attack is not yet resolved

' ANSI portrait cache. A .ans has to be RENDERED (ANSI_Print) into an image before it can be
' blitted, and re-rendering five portraits every frame would be absurd -- so each is rendered
' once at its region's pixel size and kept. Keyed by path, small and fixed: at most 5 actors
' plus the frame are on screen, and the cache is dropped between fights (FightFreeTiles).
' cached ANSI entity sprites, rendered at their authored character size (see AnsiSprite&)
CONST ASPR_MAX = 64
DIM SHARED ASPR_PATH(1 TO ASPR_MAX) AS STRING, ASPR_IMG(1 TO ASPR_MAX) AS LONG
DIM SHARED ASPR_N AS INTEGER

CONST FTILE_MAX = 24
DIM SHARED FTILE_PATH(1 TO FTILE_MAX) AS STRING, FTILE_IMG(1 TO FTILE_MAX) AS LONG
DIM SHARED FTILE_N AS INTEGER

' -- shared scratch buffer for the data-file loaders (see engine/DATA.bas) --
DIM SHARED DLINE(1 TO 600) AS STRING, DLINE_N AS INTEGER

' --- turn machinery (ENGINE, by design) ---
' Turn STRUCTURE is engine: how many steps remain, whose turn it is, whether a roll is
' owed. What a turn COSTS and what combat does with it are game rules. Today only game/
' and dungeon.bas fill these, so the ENGINE.BI hoarding audit would flag them as unused --
' they are RESERVED there on purpose, because the deeper tactical-combat screen in
' plans/PLANS.todo needs engine-side initiative + turn order and will consume them.
' See the allowlist in tests/audit-boundary.sh.
DIM SHARED AS INTEGER turn_num, steps_left, need_roll
DIM SHARED c AS CURSOR
DIM SHARED bnr_l2 AS STRING, bnr_bx1 AS INTEGER, bnr_bx2 AS INTEGER   ' last Banner's prompt line + box, for the keypress flash

' --- dice display state + DPoly polyhedron fonts ---
DIM SHARED die_a AS INTEGER, die_b AS INTEGER    ' last dice shown by RollDiceShow
' PER-DIE FACES of the last animated roll, published by EVERY renderer (pips, font polyhedra and
' the 3D dice alike). The roll helpers return a TOTAL, which is all most callers want -- but a
' roll where the dice mean DIFFERENT THINGS needs them apart. Combat initiative is the case: two
' d20s thrown together, one the player's and one the monster's, so the two sides are settled by
' the same throw the player watches rather than by a visible roll and a silent one.
' DIE_FACE_N = 0 means the last roll published nothing (Real Dice: the player rolled physically,
' so there are no faces to read).
DIM SHARED DIE_FACE(1 TO 12) AS INTEGER, DIE_FACE_N AS INTEGER
' DPoly polyhedron die fonts, indexed BY SIDE COUNT: DFONT(20) is the d20 font.
' Loaded from assets/fonts/dpoly by InitDice; 0 = failed to load (falls back to
' the number tumbler). Each glyph IS a die face: 'A'+n draws the solid variant,
' 'a'+n the outline variant -- see DieGlyphCode / DrawFontDie.
DIM SHARED DFONT(1 TO 20) AS LONG
DIM SHARED DFROT AS LONG                          ' scratch image a die renders into, then rotate-blits (tumble spin)
CONST DFROT_W = 160, DFROT_H = 200               ' scratch size (fits a d20 @56pt + headroom for the top vertex)
DIM SHARED last_raw AS INTEGER                    ' last natural dice sum (before modifiers) from DoRoll

' --- board detection: secret + regular doors auto-detected from the ANSI art ---
DIM SHARED SD_X(1 TO 500) AS INTEGER, SD_Y(1 TO 500) AS INTEGER
DIM SHARED SD_FOUND(1 TO 500) AS INTEGER, SD_N AS INTEGER
DIM SHARED FULL_BOARD AS LONG                     ' pristine DISPLAY board (layer-0 + layer-1, everything visible)
' --- the two board LAYERS (see BuildBoardImages) ---
' The board art is both the picture and the collision map, which used to force every painted
' cell to mean something to movement. Splitting it lets layer-1 hold decoration the player can
' WALK ON: it reaches the display images and never reaches the one collision samples.
DIM SHARED FULL_COLLIDE AS LONG                   ' pristine COLLISION board (layer-0 alone)
DIM SHARED COLLIDE_BOARD AS LONG                  ' played collision board (secret cells blacked)
DIM SHARED COLLIDE_ANSI AS STRING                 ' layer-0 art; falls back to the combined board
DIM SHARED DECOR_ANSI AS STRING                   ' layer-1 art; "" = no decoration layer
DIM SHARED SAVE_FILE AS STRING                    ' the save slot's path -- the GAME sets this at startup
'                                                   (was hardcoded in SAVEIO + SAVEGAME; parameterising it
'                                                    is what lets `savetest` round-trip without touching
'                                                    the player's real save)
CONST START_CX = 59, START_CY = 24                ' entrance cell: where the cursor starts on this board
DIM SHARED DOOR_X(1 TO 800) AS INTEGER, DOOR_Y(1 TO 800) AS INTEGER
DIM SHARED DOOR_STRONG(1 TO 800) AS _BYTE, DOOR_BROKEN(1 TO 800) AS _BYTE, DOOR_N AS INTEGER
' --- fog-of-war + line-of-sight + secret-region masks ---
DIM SHARED VIS(0 TO 131, 0 TO 60) AS _BYTE        ' 1 = cell currently revealed
DIM SHARED LOS_LIT(0 TO 131, 0 TO 60) AS _BYTE, LOS_SEEN(0 TO 131, 0 TO 60) AS _BYTE
DIM SHARED fov_cx AS INTEGER, fov_cy AS INTEGER   ' last position FOV was computed from
DIM SHARED DOORCELL(0 TO 131, 0 TO 60) AS _BYTE   ' 1 = a secret-door cell
DIM SHARED SECRET(0 TO 131, 0 TO 60) AS _BYTE     ' 1 = fogged (door-connected sealed cell)
DIM SHARED FOGHIDE(0 TO 131, 0 TO 60) AS _BYTE    ' 1 = force-blacked stray speck (fog-hide.txt; [~] tints it)
DIM SHARED MASKREG(0 TO 131, 0 TO 60) AS INTEGER  ' secret-mask region id per cell (0 = public); reveal-by-region
DIM SHARED MASK_ON AS INTEGER                     ' TRUE = fog driven by the hand-painted mask, not the flood
DIM SHARED DOOR_REGION(1 TO 500) AS INTEGER       ' which mask region each secret door opens
DIM SHARED MASKLVL(0 TO 255) AS INTEGER           ' nesting depth per region (1 = opened from public, 2 = secret-in-secret, ...)
DIM SHARED MASKCOL(0 TO 131, 0 TO 60) AS _UNSIGNED LONG   ' sampled mask colour per cell (region flood)
DIM SHARED CLI_COLOR AS INTEGER                   ' console (CLI-mode) colour output on/off; off strips pipe codes
DIM SHARED QX(0 TO 8000) AS INTEGER, QY(0 TO 8000) AS INTEGER   ' flood-fill queue

' --- audio PACKS / narration / art packs / music cues ---
' A subdir under assets/sfx/ or assets/music/ overrides the flat files (a "theme"). "" = flat main dir.
DIM SHARED opt_sfxpack AS STRING, opt_musicpack AS STRING
DIM SHARED SFXPACKS(0 TO 32) AS STRING, SFXPACK_N AS INTEGER      ' index 0 = "(main)" ("") ; 1..N = subdir names
DIM SHARED MUSICPACKS(0 TO 32) AS STRING, MUSICPACK_N AS INTEGER
DIM SHARED opt_narration AS INTEGER, opt_narrationpack AS STRING
DIM SHARED NARRPACKS(0 TO 32) AS STRING, NARRPACK_N AS INTEGER
' narration FREQUENCY: which tiers of narration are spoken (cumulative). 0 = Flavor only
' (rooms/chambers/ambient/win-lose), 1 = + Events (curios/traps), 2 = + Combat.
CONST NARR_FLAVOR = 0, NARR_EVENT = 1, NARR_COMBAT = 2
DIM SHARED opt_narrfreq AS INTEGER
DIM SHARED opt_artpack AS STRING
DIM SHARED ARTPACKS(0 TO 32) AS STRING, ARTPACK_N AS INTEGER
DIM SHARED opt_ansipack AS STRING                ' selected ANSI-art pack (assets/ansi-art/<pack>/); "default" = the base
' Which FORM of entity art to draw. A rendering preference, so it lives with the other display
' globals rather than in GAME.BI -- ArtFile$ (engine) is what acts on it.
'   0 = ANSI only     -- .ans only; nothing drawn if a subject has no ANSI art
'   1 = Pixel Art     -- .png only
'   2 = Hybrid        -- .png if it exists, else fall back to .ans
CONST ARTSTYLE_ANSI = 0
CONST ARTSTYLE_PIXEL = 1
CONST ARTSTYLE_HYBRID = 2
DIM SHARED opt_artstyle AS INTEGER
DIM SHARED ANSIPACKS(0 TO 32) AS STRING, ANSIPACK_N AS INTEGER
DIM SHARED opt_datapack AS STRING                ' selected DATA pack (assets/data/<pack>/ + assets/flavor/<pack>/); "default" = base game content
DIM SHARED DATAPACKS(0 TO 32) AS STRING, DATAPACK_N AS INTEGER
DIM SHARED narr_handle AS LONG                    ' the currently-playing narration line (one at a time)
DIM SHARED narr_start AS DOUBLE                   ' TIMER when the current line began (envelope is wall-clock, not playhead)
DIM SHARED narr_len AS DOUBLE                     ' _SNDLEN of the current line, read once (0 = unknown -> no fade-out)
DIM SHARED narr_fadein AS SINGLE                  ' narration fade-IN seconds (a SHARP ramp that masks the record key-click)
DIM SHARED narr_fadeout AS SINGLE                 ' narration fade-OUT seconds (masks the click at the end)
DIM SHARED narr_curve AS SINGLE                   ' fade SHAPE exponent applied to the envelope (pack.conf FADECURVE=; <1 sharp, 1 linear, >1 gentle)
DIM SHARED narr_conf_pack AS STRING               ' which pack's pack.conf is loaded into narr_fade* (cache key)
DIM SHARED narr_conf_loaded AS INTEGER            ' -1 once the fade envelope has been read at least once
DIM SHARED music_cue_active AS INTEGER            ' a non-level cue is playing over the level music

' --- audio/video + dice + char-gen SETTINGS options (engine preferences) ---
DIM SHARED opt_music AS INTEGER, opt_sfx AS INTEGER, opt_showdice AS INTEGER, opt_fullscreen AS INTEGER
DIM SHARED opt_voice AS INTEGER                                    ' typewriter text "voice" blips on/off
DIM SHARED opt_musicvol AS INTEGER, opt_sfxvol AS INTEGER, opt_voicevol AS INTEGER  ' 0..10 volume sliders
DIM SHARED opt_realdice AS INTEGER    ' player rolls their own physical dice and types the result
DIM SHARED opt_dicemath AS INTEGER    ' TRUE: player adds modifiers; FALSE: the game adds them
' --- ABILITY-ROLL METHOD (SETTINGS "Stat Roll") ---------------------------------
' Was the boolean opt_heroicstats (TRUE = 4d6-drop-lowest). A third method made a two-state flag
' the wrong shape, so it is now an enum; LoadSettings still reads the old `heroicstats` key and
' migrates it, so an existing dungeon-settings.dat keeps the method its owner chose.
'
' STAT_3D6RR re-rolls 1s and 2s UNTIL NONE REMAIN, so each die is uniform on 3..6 and a score
' runs 9..18. (The other reading -- re-roll each low die exactly once -- gives a different curve;
' this is the generous one, which is the point of the method.)
CONST STAT_3D6 = 0
CONST STAT_4D6DL = 1
CONST STAT_3D6RR = 2
DIM SHARED opt_statmethod AS INTEGER
DIM SHARED opt_fov AS INTEGER         ' TRUE: line-of-sight fog-of-war (explore the map)
' ---- dice look & feel (all persisted; see DiceColors / DrawFontDie) ----
DIM SHARED opt_dicecolor AS INTEGER   ' 0..5 index into the dice palette (Bone/Blood/Emerald/Sapphire/Gold/Amethyst)
DIM SHARED DICE_BODY(0 TO 5) AS _UNSIGNED LONG   ' dice palettes, from assets/data/dice-colors.txt
DIM SHARED DICE_INK(0 TO 5) AS _UNSIGNED LONG
DIM SHARED DICE_CNAME(0 TO 5) AS STRING
DIM SHARED STR_KEY(1 TO 400) AS STRING   ' UI string table (assets/data/strings.txt), Say$()
DIM SHARED STR_TXT(1 TO 400) AS STRING
DIM SHARED STR_N AS INTEGER
DIM SHARED opt_dicesolid AS INTEGER   ' TRUE: filled die body + contrasting number; FALSE: hollow outline
DIM SHARED opt_d6pips AS INTEGER      ' TRUE: d6 rolls use the hand-drawn pip dice; FALSE: the numbered DPoly d6
DIM SHARED opt_dicespeed AS INTEGER   ' tumble pacing: 0 Slow, 1 Normal, 2 Fast, 3 Instant (see DiceTiming)
DIM SHARED opt_dicelight AS INTEGER   ' 3D dice top-light: 0 Off, 1 Soft, 2 Normal, 3 Strong (ApplyDiceLight)
DIM SHARED opt_diceround AS INTEGER   ' 3D dice edge roundness 0 (sharp) .. 10 (very round); drives cfg.BEVEL
' -- a SEPARATE dice look for the "monster's" rolls (same options; swapped in around those rolls) --
DIM SHARED opt_mon_dicecolor AS INTEGER, opt_mon_dicesolid AS INTEGER
DIM SHARED opt_mon_d6pips AS INTEGER, opt_mon_dicespeed AS INTEGER
DIM SHARED sav_dicecolor AS INTEGER, sav_dicesolid AS INTEGER, sav_d6pips AS INTEGER, sav_dicespeed AS INTEGER
DIM SHARED opt_dice3d AS INTEGER, opt_mon_dice3d AS INTEGER, sav_dice3d AS INTEGER, dice3d_use_mon AS INTEGER
DIM SHARED DICE3D_YOFF AS INTEGER      ' rows to shift the 3D dice tray down (0 default)
' Seconds after which a "press any key" prompt advances BY ITSELF. 0 = wait for a real key.
' Deliberately generic and engine-side: the game sets it while auto-combat runs, but an attract
' mode, a demo or a headless capture all want exactly the same thing, and none of them should
' have to know what combat is.
' --- NINE-GRID UI FRAMES (engine GDK, see engine/NINEGRID.bas) ---
' Cache of frame art rendered at the UI cell.
'
' Sized well ABOVE the number of frames a game registers, and NineGridCache EVICTS when full
' rather than declining to cache. That combination is load-bearing: panels are redrawn every
' displayed frame, so a frame that MISSES the cache allocates a fresh image every time and never
' frees it. At NG_MAX 12 with eleven frames registered, one more would have started leaking
' images until the heap gave out.
' The UI's CURRENT panel frame. Engine STATE, not an engine decision: the game populates it
' (LoadUIFrames) from its own data, and the engine merely draws with whatever is there. Empty
' path = no frame, and every panel falls back to the plain LINE box it always drew.
' The message banner's box, in character cells. Named because the FLASH-the-prompt path and
' CombatPause both rewrite a line inside it and must agree with Banner about where it is.
DIM SHARED bnr_l2row AS INTEGER        ' the row Banner actually put its prompt line on
CONST BNR_ROW = 21
CONST BNR_ROWS = 9
' Frames are held in SLOTS BY PURPOSE, not by name. Every game has a message banner, a dice
' tray, a modal prompt -- the engine can name those. It cannot name "the Treasury screen", so
' game-specific panels resolve their own art game-side (FrameBox%) and never touch these.
'
' The GAME fills the slots (PublishUIFrames). An empty slot falls back to slot 0, and an empty
' slot 0 falls back to the plain LINE box every panel drew before frames existed.
' What fills a frame's CONTENT area -- the middle of the 9-grid.
'   NGF_TILE   the art's own centre tile. For a textured panel (stone, parchment).
'   NGF_BOXBG  the game's flat panel colour. The safe default: readable, and it means the
'              centre of the art can be anything (a measurement marker, a mock-up colour)
'              without that leaking onto the screen.
'   NGF_NONE   nothing -- whatever is behind the panel shows through.
CONST NGF_TILE = 0
CONST NGF_BOXBG = 1
CONST NGF_NONE = 2
CONST UIF_PANEL = 0                    ' the generic fallback
CONST UIF_BANNER = 1                   ' the message bar
CONST UIF_ROLL = 2                     ' the dice roll box
CONST UIF_GAUGE = 3                    ' the action-gesture gauge
CONST UIF_PROMPT = 4                   ' modal fuse prompts (luck, box shake)
CONST UIF_SLOTS = 5
DIM SHARED UI_FRAME_PATH(0 TO UIF_SLOTS - 1) AS STRING
DIM SHARED UI_FRAME_TW(0 TO UIF_SLOTS - 1) AS INTEGER, UI_FRAME_TH(0 TO UIF_SLOTS - 1) AS INTEGER
DIM SHARED UI_FRAME_FILL(0 TO UIF_SLOTS - 1) AS INTEGER
CONST NG_MAX = 48
DIM SHARED NG_PATH(1 TO NG_MAX) AS STRING
DIM SHARED NG_IMG(1 TO NG_MAX) AS LONG
DIM SHARED NG_OWNED(1 TO NG_MAX) AS INTEGER   ' TRUE if this image is ours to _FREEIMAGE
DIM SHARED NG_N AS INTEGER, NG_EVICT AS INTEGER
' The shipped frame's tile size, in CHARACTER cells -- the authored art is 3x these.
CONST NG_TILEW = 4
CONST NG_TILEH = 2
' HARD MUTE for headless/dev runs: those still reach the real audio device under xvfb, so a
' full test pass is minutes of beeps at whoever is sitting there. Checked at the two sound
' primitives everything funnels through, so nothing can leak past by another route.
DIM SHARED pres_scale AS SINGLE        ' window px per canvas px, published by Present
DIM SHARED pres_ox AS LONG, pres_oy AS LONG, pres_dw AS LONG, pres_dh AS LONG   ' the letterboxed canvas rect
DIM SHARED pres_noflip AS INTEGER      ' Present: blit the canvas but leave the flip to the caller
DIM SHARED audio_muted AS INTEGER
' TRUE once _SCREENSHOW has run -- i.e. "is a human looking at a window". The fatal-error
' handler branches on this rather than a curated dev-mode list, and the dev console refuses to
' open without it (a headless dev mode has no one to type into it).
DIM SHARED screen_shown AS INTEGER
DIM SHARED ui_autoadvance AS SINGLE
' DEV: when non-empty, the next dice roll saves its SETTLED frame to this file and clears the
' flag. Set by `dungeon.run rollshot`. It captures the real roll functions at the exact moment
' the player reads them -- dice landed, sum revealed -- which is the frame a layout bug shows in.
DIM SHARED roll_shot AS STRING
DIM SHARED gauge_quality AS SINGLE     ' 0..1 closeness to dead-centre on the last gesture lock
DIM SHARED opt_juice AS INTEGER        ' SETTINGS "Screen Effects": hit-shake, blood/poison splatter, near-death vignette
DIM SHARED FX_BUF AS LONG              ' offscreen snapshot buffer for the screen-shake blit
' -- near-death blood-grime overlay (pre-baked once, stretched per frame) --
CONST NBLOOD = 64
DIM SHARED BLOOD_X(1 TO NBLOOD) AS INTEGER, BLOOD_Y(1 TO NBLOOD) AS INTEGER, BLOOD_R(1 TO NBLOOD) AS INTEGER
CONST NVIG = 10                        ' pre-baked soft RADIAL vignette overlays (a HP-ramp; stretched per frame)
DIM SHARED VIG(0 TO NVIG - 1) AS LONG
CONST BLOOD_ALPHA_MAX = 200            ' near-death blood-grime opacity at full strength (SETTINGS "Blood" scales it)
DIM SHARED opt_bloodstrength AS INTEGER ' SETTINGS "Blood": near-death blood-grime intensity 0 (none) .. 10 (max)
CONST NDRIP = 16                       ' blood drips running down from the top edge (near-death overlay)
DIM SHARED DRIP_X(1 TO NDRIP) AS INTEGER, DRIP_LEN(1 TO NDRIP) AS INTEGER, DRIP_W(1 TO NDRIP) AS INTEGER
' -- poison overlay bake data (veins + slime + ooze; drawn while a status timer is up) --
CONST NVEIN = 22                       ' poison vein/branch trunks (grown inward from the rim)
CONST NVEINSEG = 240                   ' pre-baked vein line segments (trunks + child branches)
DIM SHARED VEIN_X1(1 TO NVEINSEG) AS INTEGER, VEIN_Y1(1 TO NVEINSEG) AS INTEGER
DIM SHARED VEIN_X2(1 TO NVEINSEG) AS INTEGER, VEIN_Y2(1 TO NVEINSEG) AS INTEGER
DIM SHARED VEIN_GEN(1 TO NVEINSEG) AS INTEGER, VEIN_N AS INTEGER
CONST NSLIME = 48                      ' green slime blobs pooling around the frame
DIM SHARED SLIME_X(1 TO NSLIME) AS INTEGER, SLIME_Y(1 TO NSLIME) AS INTEGER, SLIME_R(1 TO NSLIME) AS INTEGER
CONST NOOZE = 14                       ' green ooze drips running down from the top edge
DIM SHARED OOZE_X(1 TO NOOZE) AS INTEGER, OOZE_LEN(1 TO NOOZE) AS INTEGER, OOZE_W(1 TO NOOZE) AS INTEGER
' -- configurable UI fonts (assets/data/ui-fonts.txt -> LoadUIFonts) --
DIM SHARED UIF_LABEL AS LONG, UIF_MSG AS LONG, UIF_COMBAT AS LONG, UIF_MENU AS LONG, UIF_HUD AS LONG
DIM SHARED opt_dice3d_set AS INTEGER, opt_mon_dice3d_set AS INTEGER   ' 1-based index into dicesets.txt
DIM SHARED opt_dicefont AS INTEGER    ' which numeral font (1-based index into dicefonts.txt)

' --- WINDOW RESIZE (handled inside Present, engine/UI.bas) --------------------
' The window surface is OURS: screen 0 is a real window-sized image and CANVAS is an offscreen
' 132x51 character grid that Present blits into it at an INTEGER scale (see engine/UI.bas).
' Present consumes the _RESIZE event and takes the new size at once, then a short corrective
' watcher catches the last event of a drag if the window manager dropped it. There is exactly
' ONE consumer on purpose: reading _RESIZE clears it, so a second reader steals the event, and
' a second uncoordinated SCREEN _NEWIMAGE feeds the resize back on itself.
DIM SHARED rsz_settle AS INTEGER      ' frames left before a resize counts as finished
DIM SHARED rsz_w AS LONG, rsz_h AS LONG   ' last requested window size
DIM SHARED display_dirty AS INTEGER   ' a settled resize wants a FULL repaint; loops consume it
' Present's last blit geometry -- the letterbox bars only need repainting when this changes.
DIM SHARED pres_lastw AS LONG, pres_lasth AS LONG, pres_winw AS LONG, pres_winh AS LONG
' How many _RESIZE events Present must SWALLOW because it caused them itself. Its own
' SCREEN _NEWIMAGE raises one; acting on that would recreate the screen again, and again --
' a feedback loop that looks like the display having a fit. (DRAW calls this
' SCREEN_DEFERRED_RESIZE%; same idea, same reason.)
DIM SHARED pres_deferred AS INTEGER
' The windowed size to come back to when leaving fullscreen. Entering fullscreen forces screen 0
' to the canvas size so _FULLSCREEN _SMOOTH has the whole scale to antialias (see ApplyDisplay).
DIM SHARED pres_winsave_w AS LONG, pres_winsave_h AS LONG
' This frame's canvas as a HARDWARE texture, for smooth windowed scaling. Rebuilt per frame
' because QB64 has no way to update a hardware image in place -- and only when the window is
' actually scaling, so a 1:1 window pays nothing. 0 = none, and Present falls back to _PUTIMAGE.
DIM SHARED pres_hw AS LONG
' SETTINGS "Smoothing": 0 off (crisp, integer scale) .. 3 full (softest). Above 0 it also picks
' fit-to-window scaling, because a fractional scale is only worth having if it gets filtered.
DIM SHARED opt_smoothamt AS INTEGER
' The crisp integer PRESCALE buffer and its factor. Filtering blurs over one source texel, so
' blowing the canvas up sharply first and filtering only the remainder is what makes "how much"
' adjustable at all -- GL itself offers only nearest or linear.
DIM SHARED pres_pre AS LONG, pres_pre_scale AS INTEGER
' Latched TRUE once _COPYIMAGE(..., 33) has refused: no GL context (software rasteriser, remote
' X without GLX, headless). Stops us asking 60 times a second and pins the crisp fallback.
DIM SHARED pres_nohw AS INTEGER
DIM SHARED opt_msgdelay AS INTEGER    ' auto-advance hold for banner messages: 1..5 seconds, or 0 = wait for a key
DIM SHARED SVTOK(1 TO 12000) AS STRING, SVTOK_N AS INTEGER, SVTOK_I AS INTEGER   ' save-file token stream
' --- active-character stat scaffolding (generic RPG stats; JUICE reads player_hp) ---
DIM SHARED player_hp AS INTEGER, player_maxhp AS INTEGER   ' adventurer hit points
DIM SHARED player_dmgdie AS INTEGER   ' weapon damage die (engine/GESTURE.bas CritFlourish% rolls it)
' --- music + sound-effect subsystem ---
CONST MUSIC_FADE_SEC = 2.5                        ' music fade/crossfade duration, seconds (hardcoded; fade-in from silence AND track-to-track)
CONST NARR_FADE_IN_DEF = .25                      ' default narration fade-in seconds -- a SHARP ramp (pack.conf FADEIN= overrides)
CONST NARR_FADE_OUT_DEF = .5                      ' default narration fade-out seconds (pack.conf FADEOUT= overrides)
CONST NARR_FADE_CURVE_DEF = .5                    ' default fade SHAPE exponent: <1 sharp/fast rise, 1 linear, >1 gentle (pack.conf FADECURVE=)
DIM SHARED music_handle AS LONG                  ' currently-looping menu/level music (for live volume)
DIM SHARED music_fadeout AS LONG                 ' the PREVIOUS track, crossfading out under a transition (0 = none)
DIM SHARED music_fade_start AS DOUBLE            ' TIMER when the current crossfade began
DIM SHARED music_fading AS INTEGER               ' -1 while a crossfade ramp is in progress
' --- sound GRAVEYARD: deferred _SNDCLOSE (see RetireSound / ReapSounds in MUSIC.bas).
'     _SNDOPEN adds a node to miniaudio's mixing graph that a DEVICE THREAD walks every buffer
'     callback; _SNDCLOSE frees that node from the game thread. Freeing one the mixer is mid-read
'     of is a heap double-free -- it aborted a real session with `double free or corruption
'     (fasttop)` while the player walked the SETTINGS Music Pack row (13 packs, one open+close per
'     keypress, well inside the 2.5s crossfade). Nothing closes a sound directly any more: it is
'     silenced, stopped, and parked here, and ReapSounds (from AudioTick) frees it a beat later. ---
CONST SND_RETIRE_SEC = .5                        ' seconds a retired sound waits before it MAY be freed
CONST SND_RETIRE_CAP_SEC = 5                     ' ...and past this it is freed regardless (see SoundRetireReady%)
CONST SND_RETIRE_MAX = 80                      ' queue depth: the 48 SFX slots + music + narration + slack
DIM SHARED RETIRE_HND(1 TO SND_RETIRE_MAX) AS LONG   ' parked handles awaiting _SNDCLOSE (0 = free slot)
DIM SHARED RETIRE_AT(1 TO SND_RETIRE_MAX) AS DOUBLE  ' TIMER when each was parked
DIM SHARED RETIRE_N AS INTEGER                   ' high-water mark of slots in use
' --- audio MIXER: dedicated channels (music / voice / sfx), each auto-mixed by QB64.
'     Final volume per channel = player slider x channel gain x (duck / fade / envelope). ---
CONST CH_MUSIC = 0, CH_VOICE = 1, CH_SFX = 2     ' channel ids for ChannelGain
CONST DUCK_ATTACK = .06                           ' per-frame step to duck DOWN under voice (fast, ~0.15s)
CONST DUCK_RELEASE = .02                          ' per-frame step to restore UP after voice (gentle, ~0.5s)
DIM SHARED opt_duckamt AS INTEGER                 ' SETTINGS 0..10: how far music dips under narration (0 off, 10 = silent under voice)
DIM SHARED music_duck AS SINGLE                   ' live music duck multiplier (1 = open, dips toward 1-opt_duckamt/10 under voice)
DIM SHARED chgain_music AS SINGLE                 ' programmatic per-channel gain on TOP of the player's slider (1 = unity)
DIM SHARED chgain_voice AS SINGLE
DIM SHARED chgain_sfx AS SINGLE
DIM SHARED MUSIC_FILE(1 TO 9) AS STRING          ' music file assigned to each dungeon level (in assets/music/)
DIM SHARED music_level AS INTEGER                ' the level whose track is loaded right now (0 = none)
DIM SHARED music_curfile AS STRING               ' the file currently loaded (so same-file levels don't restart it)
DIM SHARED SFX_NAME(1 TO 48) AS STRING, SFX_HND(1 TO 48) AS LONG, SFX_N AS INTEGER
DIM SHARED SFX_PATH(1 TO 48) AS STRING           ' the file each slot actually resolved to ("" = beeper fallback)

' --- ASSET TELEMETRY -- "what is playing / showing RIGHT NOW", for the [`] dev console and the
'     [Shift-TAB] bearings overlay. Recording is deliberately at the CHOKEPOINTS (Sfx, Narrate,
'     BeginTrack, DrawSpriteFit%) rather than at call sites, so a feature added later is logged
'     without anyone remembering to log it -- the same argument that puts the resize in Present. ---
DIM SHARED music_path AS STRING                  ' resolved FILE behind music_handle (music_curfile is the bare NAME)
DIM SHARED music_fadeout_path AS STRING          ' ...and behind the outgoing crossfade track
DIM SHARED narr_key AS STRING                    ' strings.txt key of the current/last narration line
DIM SHARED narr_path AS STRING                   ' ...and the file it resolved to
DIM SHARED narr_at AS DOUBLE                     ' TIMER when it started
CONST SNDLOG_MAX = 24                            ' recent-SFX ring depth
DIM SHARED SFXLOG_NAME(1 TO SNDLOG_MAX) AS STRING, SFXLOG_PATH(1 TO SNDLOG_MAX) AS STRING
DIM SHARED SFXLOG_AT(1 TO SNDLOG_MAX) AS DOUBLE
DIM SHARED SFXLOG_W AS INTEGER                   ' ring WRITE cursor (wraps; 0 = nothing logged yet)
CONST IMGLOG_MAX = 32                            ' recently-BLITTED sprite ring depth
DIM SHARED IMGLOG_PATH(1 TO IMGLOG_MAX) AS STRING, IMGLOG_AT(1 TO IMGLOG_MAX) AS DOUBLE
DIM SHARED IMGLOG_W AS INTEGER
CONST RECENT_SEC = 10                            ' "playing or played recently" window, seconds

' ============================================================================
'  DEV CONSOLE  [`]  +  the DUMP REGISTRY
'
'  A Quake-style drop-down console, opened by BACKTICK from ANY screen -- menus,
'  dialogs, the dice tumble, a fade -- because its hotkey is polled in Present,
'  this game's one true per-frame chokepoint (see the long note there; the same
'  argument that put _RESIZE handling in Present rather than in forty loops).
'  [~] is unchanged and still toggles the board debug overlay.
'
'  THE DUMP REGISTRY exists so these stay maintained rather than rotting into a
'  pile of orphaned one-offs. The contract is mechanical, and tests/audit-dumps.sh
'  enforces both halves of it:
'
'    * a topic named `foo` is implemented by a SUB named exactly `Dump_Foo`
'    * every Dump_* SUB is registered, and every registered topic has a Dump_* SUB
'
'  So adding a dump is: write Dump_Thing, register it, done -- and forgetting
'  either half fails the gate instead of silently shipping a dead `dump thing`.
'  Engine topics live in engine/CONSOLE.bas; game topics live in game/DUMP.bas
'  and are reached through the Game_RegisterDumps / Game_DevDump% hook pair, so
'  the engine still names no game symbol.
' ============================================================================
CONST DUMP_MAX = 32
DIM SHARED DUMP_NAME(1 TO DUMP_MAX) AS STRING    ' topic word typed after `dump`
DIM SHARED DUMP_DESC(1 TO DUMP_MAX) AS STRING    ' one-line help, shown by `dump` with no argument
DIM SHARED DUMP_OWNER(1 TO DUMP_MAX) AS STRING   ' "engine" | "game" -- which side implements it
DIM SHARED DUMP_N AS INTEGER
DIM SHARED dump_registered AS INTEGER            ' registry built once, lazily (order-independent startup)

CONST CON_MAX = 500                              ' scrollback lines
CONST CON_HIST = 32                              ' command history depth
CONST CON_ROWS = 24                              ' visible rows of the drop-down panel
DIM SHARED CONBUF(1 TO CON_MAX) AS STRING
DIM SHARED CONCOL(1 TO CON_MAX) AS _UNSIGNED LONG
DIM SHARED CON_N AS INTEGER                      ' lines written (ring: oldest scrolled off)
DIM SHARED con_scroll AS INTEGER                 ' rows scrolled back from the newest (0 = bottom)
DIM SHARED con_line AS STRING                    ' the input line being typed
DIM SHARED con_active AS INTEGER                 ' -1 while the console owns the screen (re-entry guard for Present)
DIM SHARED con_snap AS LONG                      ' snapshot of CANVAS taken on open, restored on close
DIM SHARED con_down AS INTEGER                   ' backtick edge-detect: was it held on the previous poll?
DIM SHARED CONHIST(1 TO CON_HIST) AS STRING
DIM SHARED CONHIST_N AS INTEGER, CONHIST_I AS INTEGER
