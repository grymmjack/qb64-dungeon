# extensionless files
# Ignore all
*

# Unignore all with extensions
!*.*

# Unignore all dirs
!*/

# Unignore include
!include/*

# Ignore VS Code stuff
.vscode
.DS_Store
*.exe
*.run
*.command
.vscode/launch.json
*.bas-bak
*.bi-bak
*.bm-bak
*.cmp-out

# Screenshot captures (regenerable via scratchpads/shots/capture.sh, which stays tracked)
scratchpads/shots/*.png

# Claude Code local files (activity log etc.)
.claude/
# runtime hall-of-fame save
dungeon-lords.dat
dungeon-lords-maps/
dungeon-settings.dat
dungeon-stats.csv
dungeon-save.dat*
# big lossless render kept locally; the game/playlist uses the .ogg
assets/music/level2.wav
# physical rulebook + card scans -- OCR'd to manuals/*.txt (committed); keep the big scans local
Game Manual.pdf
Introductory Game.pdf
Monster Cards.pdf
Treasure Cards.pdf
Spell Cards.pdf
Grave and Number.pdf
BOARD.png
# Bitwig project files ARE tracked, but its extensionless marker is caught by the
# top "* / !*.*" rule -- unignore it so the project folder is complete
!assets/music/bitwig/**/.bitwig-project

chamberdump.png
chamberdump.txt

# generation run logs (noise; regenerate any time)
*.log
