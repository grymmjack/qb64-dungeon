# extensionless files
# Ignore all
*

# Unignore all with extensions
!*.*

# Unignore all dirs
!*/

# Unignore include
!include/*

# Ignore VS Code stuff
.vscode
.DS_Store
*.exe
*.run
*.command
.vscode/launch.json
*.bas-bak
*.bi-bak
*.bm-bak
*.cmp-out

# Screenshot captures (regenerable via scratchpads/shots/capture.sh, which stays tracked)
scratchpads/shots/*.png

# Claude Code local files (activity log etc.)
.claude/
# runtime hall-of-fame save
dungeon-lords.dat
dungeon-lords-map-*.png
dungeon-settings.dat
dungeon-stats.csv
dungeon-save.dat*
assets/music/bitwig/level1/.bitwig-project
assets/music/bitwig/level1/level1.bwproject
assets/music/bitwig/level1/auto-backups/level1/level1 \[2026-07-26 113846].bwproject
