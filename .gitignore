# extensionless files
# Ignore all
*

# Unignore all with extensions
!*.*

# Unignore all dirs
!*/

# Unignore include
!include/*

# Python bytecode caches (the asset generators are python).
# NOTE this file inverts the usual scheme -- `*` ignores everything, then `!*.*` unignores
# anything with an extension and `!*/` unignores directories. So __pycache__/*.pyc would be
# UNIGNORED by those rules; it needs an explicit re-ignore here, after them.
__pycache__/
*.pyc
*.pyo

# Ignore VS Code stuff
.continue
.vscode
.DS_Store
*.exe
*.run
*.command
.vscode/launch.json
*.bas-bak
*.bi-bak
*.bm-bak
*.cmp-out

# Screenshot captures (regenerable via scratchpads/shots/capture.sh, which stays tracked)
scratchpads/shots/*.png
# mini-game prototype frames -- regenerable with `./X.run shot`
scratchpads/minigames/*.png
scratchpads/minigames/*.run

# Claude Code: the SKILLS and shared settings belong to the project and are tracked; the
# per-machine and transient bits are not. `.claude/*` matches direct children only (git's `*`
# does not cross a `/`), so re-including the skills dir also re-includes everything under it.
.claude/*
!.claude/skills/
!.claude/settings.json
# ...and the local-only pieces, listed after the re-includes so they still lose:
.claude/activity.log
.claude/settings.local.json
.claude/worktrees/
# all runtime saves/prefs/stats/maps live here (game MKDIRs it at startup)
gameplay-data-saves/
# big lossless render kept locally; the game/playlist uses the .ogg
assets/music/level2.wav
# (the rulebook/card PDF scans + BOARD.png moved to docs/ and are now TRACKED)
# Bitwig project files ARE tracked, but its extensionless marker is caught by the
# top "* / !*.*" rule -- unignore it so the project folder is complete
!assets/music/bitwig/**/.bitwig-project
assets/music/bitwig/**/auto-backups/

chamberdump.png
chamberdump.txt
fogdump.png
fightlayout.png
fightshot.png
fogdump-regions.png
fogdump.txt

# generation run logs (noise; regenerate any time)
*.log
settings-shot.png
settings-window.png
charsheet.png
charsheet-fresh.png
rollshot-*.png
roomlint.png
d4lean.png
gaugeshot.png
summaryshot.png
deathshot.png
# diceobj/ IS tracked -- ALL of it, renders included. The exported meshes, their atlases, the
# face-value sidecars, the .blend Rick hand-edits, and the rendered PNGs are the source for
# promo and 2D art. The render is the thing you actually reach for; ignoring it meant the one
# useful artefact was the one you could not check out.
summaryshot-overlay.png
gaugeshot-timed.png
sectorauto.png

# headless engine test harness: compiled suites + their scratch dir
tests/*.run
tests/*.exe
tests/tmp/

# separability-proof binary (examples/minimal)
examples/*/*.run
examples/*/*.exe
bannershot.png
bannershot-wide.png
frameshot.png
panelshot.png
statshot.png
creatorshot.png
cutplay.run
cutscene-shot.png
cutshot-*.png
storyshot-*.png
