' ============================================================================
'  DUNGEON.BI -- constants, TYPEs and shared globals (top include)
' ============================================================================
' --- game states ---
CONST ST_INTRO = 0, ST_MENU = 1, ST_PLAY = 2, ST_WIN = 3, ST_LOSE = 4, ST_QUIT = 5
' --- menu results ---
CONST MENU_ENTER = 1, MENU_FLEE = 2
' --- play outcomes ---
CONST OUT_WIN = 1, OUT_LOSE = 2, OUT_FLEE = 3
' --- the entrance chamber (cell coords) ---
CONST START_CX = 59, START_CY = 24
' --- gameplay tuning (potions, encounters, XP) ---
CONST POTION_SMALL_DIE = 4        ' Small Healing Potion heals 1d4
CONST POTION_LARGE_DIE = 8        ' Large Healing Potion heals 1d8...
CONST POTION_LARGE_BONUS = 1      ' ...+1  (Large potion heals 1d8+1)
CONST TREASURE_POTION_PCT = 15    ' % chance a slain hoard also yields a potion -- kept lean
CONST TREASURE_LARGE_PCT = 25     ' when a hoard potion drops, % chance it's the LARGE (1d8+1) kind
CONST LEVELCLEAR_LARGE_PCT = 30   ' % chance clearing a level also yields a Large potion
CONST IDLE_ENCOUNTER_PCT = 30     ' % chance a wanderer appears once the loiter meter is full
CONST LOITER_THRESHOLD = 3        ' loiter ticks (searches / idle beats) before a wander check
CONST WANDER_GOLD_DIV = 6         ' wandering-monster gold = level treasure / this (lean -- no farming)
CONST XP_PER_KILL_LVL = 10        ' XP per slain monster = its dungeon level * this (+ boss bonus)
CONST CHEST_PCT = 20              ' % chance a curio turns up after a room fight
CONST CHEST_TRAP_PCT = 25         ' % chance a curio CHEST is trapped
CONST CURIO_PATH_PCT = 3          ' % chance per explored corridor step that a curio turns up
CONST CURIO_COOLDOWN = 16         ' minimum steps between path curios (anti-spam)
TYPE CURIO_T
    kind AS STRING * 12           ' the mechanic (dispatched in code)
    nm AS STRING * 24             ' display name
    weight AS INTEGER             ' relative spawn frequency
    prompt AS STRING * 96         ' the discovery line
END TYPE
DIM SHARED CURIOS(1 TO 40) AS CURIO_T
DIM SHARED NCURIO AS INTEGER
DIM SHARED curio_cool AS INTEGER  ' steps since the last path curio (counts down)
' -- optional PIXEL-ART layer (assets/pixel-art/, generated by ~/pixelmon). Complements the
'    ANSI board with sprite portraits in panels (combat, character sheet). Graceful if missing. --
DIM SHARED opt_artstyle AS INTEGER        ' 0 = ANSI only, 1 = Pixel Art, 2 = Hybrid (ANSI board + pixel portraits)
DIM SHARED SPR_PATH(1 TO 200) AS STRING   ' loaded-sprite cache: path -> image handle (0 = missing)
DIM SHARED SPR_H(1 TO 200) AS LONG
DIM SHARED SPR_N AS INTEGER
CONST SIREN_ENCOUNTER_BOOST = 20  ' + to the wandering-encounter % while a magic siren wails
CONST SIREN_MOVE_PCT = 15         ' % chance each step (while a siren wails) to draw an encounter
CONST FLEE_FAIL_BASE = 15         ' % chance a flee attempt fails (monster drags you back) on level 1
CONST FLEE_FAIL_STEP = 5          ' + this % per dungeon level deeper (level 9 = 15 + 8*5 = 55%)

TYPE SECTOR
    start_x AS INTEGER
    start_y AS INTEGER
    end_x   AS INTEGER
    end_y   AS INTEGER
    kolor   AS _UNSIGNED LONG
    label   AS STRING
    monster AS STRING
    mnum    AS INTEGER       ' 2d6 total needed to defeat (baked for the roller's class)
    mslot   AS INTEGER       ' which of the level's 3 monsters (for per-player kill numbers)
    mgold   AS INTEGER       ' treasure guarded (sits under the monster)
    malive  AS INTEGER
    is_boss AS INTEGER       ' room flag: tougher guardian
    treasure AS INTEGER      ' gold value of the treasure the monster guards
    treasure_name AS STRING  ' name of that treasure (Dungeon!-style)
    trapped AS INTEGER       ' the treasure is trapped
    looted  AS INTEGER       ' treasure already taken
    secret_here AS INTEGER   ' (unused) legacy flag
    secret_found AS INTEGER  ' (unused) legacy flag
    treasure_item AS INTEGER ' special-item code for this room's treasure (see TRE_ITEM)
    monster_fought AS INTEGER ' room flag: combat has happened here
    player_died AS INTEGER    ' room flag: the player was slain/downed here
    mhp     AS INTEGER       ' D&D mode: monster max hit points
    mhp_now AS INTEGER       ' D&D mode: monster current hit points (mid-fight)
    mac     AS INTEGER       ' D&D mode: monster armor class (d20+tohit must meet/beat)
END TYPE

' An individual room block (a colored rectangle within a sector). EVERY reachable
' room holds a monster guarding a treasure -- detected by flood-fill (DetectRooms).
TYPE ROOM
    sec     AS INTEGER        ' which sector/level this block belongs to
    cells   AS INTEGER        ' size of the block (tiny blocks = labels, no encounter)
    cx      AS INTEGER        ' centre cell (for the tombstone marker + combat)
    cy      AS INTEGER
    monster AS STRING * 18
    mslot   AS INTEGER        ' which of the level's 3 monsters (per-class kill numbers)
    is_boss AS INTEGER
    malive  AS INTEGER
    mhp     AS INTEGER
    mhp_now AS INTEGER
    mac     AS INTEGER
    treasure AS INTEGER
    treasure_name AS STRING * 22
    treasure_item AS INTEGER
    looted  AS INTEGER
    monster_fought AS INTEGER
    player_died AS INTEGER
    seen    AS INTEGER        ' the player has entered this room -- only then is its monster drawn
    ' loot a fallen champion left here (multiplayer only -- recoverable by any player)
    drop_gold AS LONG
    drop_sword AS INTEGER
    drop_secret AS INTEGER
    drop_esp AS INTEGER
    drop_crystal AS INTEGER
END TYPE

TYPE CURSOR
    x            AS INTEGER
    y            AS INTEGER
    prev_x       AS INTEGER
    prev_y       AS INTEGER
    cursor_color AS _UNSIGNED LONG
END TYPE

TYPE PCLASS
    name         AS STRING
    gold_goal    AS LONG
    combat_bonus AS INTEGER     ' added to the 2d6 attack roll (Oldschool mode)
    secret_bonus AS INTEGER     ' edge at finding secret doors
    blurb        AS STRING
    hp           AS INTEGER     ' D&D mode: base max hit points (fallback if not rolled)
    tohit        AS INTEGER     ' D&D mode: base bonus added to the d20 attack roll
    dmg          AS INTEGER     ' D&D mode: damage die (sides)
    ac           AS INTEGER     ' D&D mode: base armor class (defence)
    hitdie       AS INTEGER     ' D&D mode: hit die size for rolling HP at character creation
END TYPE

' One hot-seat player's complete state (parked here between turns; the active
' player's state lives in the working globals -- see Load/SaveActivePlayer).
TYPE PLAYER
    active   AS INTEGER         ' still in the game
    name     AS STRING * 40     ' fixed-length (variable-len in a UDT array crashes QB64); 40 fits long random names
    klass    AS INTEGER         ' class index 1..4
    gold     AS LONG
    goal     AS LONG
    has_key  AS INTEGER
    sword    AS INTEGER
    secret_card AS INTEGER
    esp      AS INTEGER
    crystal  AS INTEGER
    hp       AS INTEGER
    maxhp    AS INTEGER
    sstr     AS INTEGER
    sint     AS INTEGER
    swis     AS INTEGER
    sdex     AS INTEGER
    scon     AS INTEGER
    scha     AS INTEGER
    tohit    AS INTEGER
    ac       AS INTEGER
    dmgdie   AS INTEGER
    dmgbonus AS INTEGER
    cx       AS INTEGER         ' cursor pixel position
    cy       AS INTEGER
    kolor    AS _UNSIGNED LONG  ' board token colour
END TYPE

DIM SHARED AS INTEGER SW, SH, CW, CH
DIM SHARED AS LONG CANVAS, CANVAS_COPY
DIM SHARED AS _UNSIGNED LONG YELLOW, BLACK, BROWN, BRIGHT_BLUE
DIM SHARED AS _UNSIGNED LONG WHITE, GREY, REDU, GREENU, YELLOWU, CYANU, BOXBG
DIM SHARED BOARD_ANSI AS STRING
DIM SHARED SECTORS(1 TO 9) AS SECTOR
' individual room blocks (per-block encounters), detected from the board art
DIM SHARED ROOMS(1 TO 400) AS ROOM, ROOM_N AS INTEGER
' Spoils left where an adventurer FELL on the open PATHS. A room death stashes loot in
' the room's own drop_* fields (marker + reclaim already handled per-room); a path/wander
' death has no room, so it drops HERE, keyed to the exact board cell -- painted as a body
' marker and reclaimed by stepping onto that cell (see AddLooseDrop / CollectLooseAt).
TYPE LOOSEDROP
    active AS INTEGER
    cx AS INTEGER
    cy AS INTEGER
    gold AS LONG
    sword AS INTEGER
    secret AS INTEGER
    esp AS INTEGER
    crystal AS INTEGER
END TYPE
DIM SHARED LOOSE(1 TO 16) AS LOOSEDROP
DIM SHARED ROOMAT(0 TO 131, 0 TO 60) AS INTEGER   ' cell -> room index (0 = not a room cell)
DIM SHARED LABELMASK(0 TO 131, 0 TO 60) AS INTEGER   ' cell -> TRUE if a room label prints here (keep monsters off it)
DIM SHARED DOOROPEN(0 TO 131, 0 TO 60) AS INTEGER    ' cell -> TRUE once a door has been passed through (FOV: closed doors block sight)
DIM SHARED LBL_N AS INTEGER, LBL_X(1 TO 40) AS INTEGER, LBL_Y(1 TO 40) AS INTEGER, LBL_T(1 TO 40) AS STRING
' -- room/combat flavor text (loaded from editable assets/flavor/*.txt; see FLAVOR.bas) --
DIM SHARED REG_FLAV(1 TO 9, 1 TO 24) AS STRING, REG_N(1 TO 9) AS INTEGER   ' regular-room one-liners per level
DIM SHARED SP_KEY(1 TO 30) AS STRING, SP_X(1 TO 30) AS INTEGER, SP_Y(1 TO 30) AS INTEGER, SP_N AS INTEGER
DIM SHARED SP_FLAV(1 TO 30, 1 TO 8) AS STRING, SP_FN(1 TO 30) AS INTEGER   ' special (named) room deep flavor
DIM SHARED SP_ROOM(1 TO 30) AS INTEGER   ' each named label bound to its nearest detected room (BindSpecialRooms)
DIM SHARED MAXHIT(1 TO 30) AS STRING, MAXHIT_N AS INTEGER                  ' max-damage combat flavor
DIM SHARED FORFEIT_FLAV(1 TO 30) AS STRING, FORFEIT_N AS INTEGER           ' sad epitaphs shown when a run is forfeited (all lives spent)
DIM SHARED deaths(1 TO 4) AS INTEGER              ' per-player death tally (skull counter in the HUD)

' -- Crit/Fumble effects engine (data-driven; see InitEffects) --
' kind: 0 flavor-only, 1 heal player, 2 extra dmg to foe, 3 self-damage, 4 lose turn, 5 drop gold
TYPE FXROW
    say  AS STRING * 96      ' template; tokens {weapon} {mon} {n} are substituted at show time
    kind AS INTEGER
    die  AS INTEGER          ' magnitude die for the mechanical effect (0 = none)
END TYPE
DIM SHARED CRITFX(1 TO 30) AS FXROW, NCRIT AS INTEGER      ' player critical-hit results
DIM SHARED PFUMBLE(1 TO 30) AS FXROW, NPFUM AS INTEGER     ' player fumble results
DIM SHARED MFUMBLE(1 TO 30) AS FXROW, NMFUM AS INTEGER     ' monster natural-1 fumble results

' -- Curio-chest traps (data-driven; loaded from assets/data/traps.txt; see SpringTrap) --
TYPE TRAPROW
    kind AS INTEGER          ' mechanic: 1 poison, 2 bomb, 3 frost, 4 siren
    name AS STRING * 20
    save AS STRING * 4       ' CON / DEX / WIS
    word AS STRING * 8       ' save verb: SAVE / DODGE
    sfx  AS STRING * 8
    die  AS INTEGER          ' magnitude die (damage or turns)
    trig AS STRING * 72      ' trigger banner (line 1)
    smsg AS STRING * 72      ' save-success banner (line 1)
    ftit AS STRING * 56      ' failure banner title (line 1)
    fbod AS STRING * 72      ' failure banner body (line 2); {n} = rolled magnitude
END TYPE
DIM SHARED TRAPS(1 TO 20) AS TRAPROW, NTRAP AS INTEGER

' -- shared scratch buffer for the data-file loaders (see DATA.bas) --
DIM SHARED DLINE(1 TO 600) AS STRING, DLINE_N AS INTEGER

' -- per-monster / per-class combat event text (data-driven; see CTEXT.bas) --
' Each row is one line for one (category, key, event). key "*" is the default used
' when a specific monster/class has no line of its own for that event.
TYPE EVTROW
    cat  AS INTEGER          ' 1 = monster, 2 = player class
    mkey AS STRING * 24      ' monster name / class name (UPPER), or "*"  (KEY is reserved)
    evt  AS INTEGER          ' 1 attack, 2 miss, 3 crit, 4 fumble, 5 death
    text AS STRING * 140     ' template; tokens like {mon} {dmg} {player} are filled at show time
END TYPE
DIM SHARED EVT(1 TO 1400) AS EVTROW, EVT_N AS INTEGER
' flavor-context globals: combat sets these so Fill$ can resolve the {tokens}
DIM SHARED FX_MON AS STRING, FX_DMG AS INTEGER, FX_LEVEL AS INTEGER
DIM SHARED FX_ROOM AS STRING, FX_TREASURE AS STRING, FX_ITEM AS STRING
DIM SHARED c AS CURSOR
DIM SHARED AS LONG gold, target_gold
DIM SHARED AS INTEGER turn_num, steps_left, need_roll
DIM SHARED class_name AS STRING
DIM SHARED CLASSES(1 TO 4) AS PCLASS
DIM SHARED player_class AS INTEGER
' hot-seat multiplayer (up to 4). num_players 1 = solo; >1 forces Boardgame Mode.
DIM SHARED PLAYERS(1 TO 4) AS PLAYER
DIM SHARED num_players AS INTEGER, cur_player AS INTEGER
' per-player log of named treasures claimed (for the character sheet). Plain string
' arrays are safe (unlike variable-length strings inside a UDT array).
DIM SHARED LOOT_NAME(1 TO 4, 1 TO 80) AS STRING, LOOT_GOLD(1 TO 4, 1 TO 80) AS LONG
DIM SHARED LOOT_N(1 TO 4) AS INTEGER
' Dungeon!-style monster + treasure pools, 3 per level (levels 1-9), randomised per game.
DIM SHARED MON_NAME(1 TO 9, 1 TO 3) AS STRING
' per-class 2d6 kill numbers from the cards: [level, slot, class] 1=Hero 2=Elf 3=Superhero 4=Wizard (13 = can't kill barehanded)
DIM SHARED MON_N(1 TO 9, 1 TO 3, 1 TO 4) AS INTEGER
DIM SHARED TRE_NAME(1 TO 9, 1 TO 3) AS STRING, TRE_GOLD(1 TO 9, 1 TO 3) AS INTEGER
DIM SHARED TRE_ITEM(1 TO 9, 1 TO 3) AS INTEGER   ' 0=gold, 1=MagicSword+1, 2=MagicSword+2, 3=SecretDoorCard
DIM SHARED BOSS_NAME(1 TO 4) AS STRING
' player inventory (special treasure cards)
DIM SHARED item_sword AS INTEGER      ' Magic Sword combat bonus held (0/1/2)
DIM SHARED item_secret_card AS INTEGER ' holds the Secret Door Card
DIM SHARED item_esp AS INTEGER        ' ESP Medallion: peek the treasure a monster guards
DIM SHARED item_crystal AS INTEGER    ' Crystal Ball: [V] scry every room's contents
' expanded magic-item deck (see ClaimTreasure / InitMonsterTables)
DIM SHARED item_armor AS INTEGER      ' AC bonus from BODY ARMOR worn (0 if none)
DIM SHARED item_shield AS INTEGER     ' AC bonus from a SHIELD (separate slot; adds to armor)
DIM SHARED item_bow AS INTEGER        ' Magic Bow: +2 to-hit (strike from range)
DIM SHARED item_boots AS INTEGER      ' Elf Boots: +2 to the movement roll
DIM SHARED item_teleport AS INTEGER   ' Teleport Scrolls held: [T] whisks you back to START
DIM SHARED item_potion_small AS INTEGER, item_potion_large AS INTEGER   ' healing potions held ([H] to quaff)
DIM SHARED char_level AS INTEGER, char_xp AS LONG   ' D&D character level + accumulated XP (levels up on clearing a floor)
DIM SHARED combat_round AS INTEGER   ' current D&D combat round (shown on the combat panel)
' Kept combat context so any board redraw (a dice-roll's cleanup, etc.) can repaint the combat
' panel -- it stays CONSTANT during a fight instead of vanishing behind rolls and banners.
DIM SHARED combat_active AS INTEGER  ' TRUE only while DoCombatDnD is running
DIM SHARED combat_rm AS INTEGER
DIM SHARED combat_mon AS STRING
DIM SHARED combat_lead AS STRING
DIM SHARED bnr_l2 AS STRING, bnr_bx1 AS INTEGER, bnr_bx2 AS INTEGER   ' last Banner's prompt line + box, for the keypress flash
' -- status effects from curio traps (tick down as turns pass; shown in the HUD) --
DIM SHARED poison_turns AS INTEGER   ' poison darts: -1 HP per turn (damage over time)
DIM SHARED fire_turns AS INTEGER     ' bomb fire: -1 HP per turn (damage over time)
DIM SHARED frost_turns AS INTEGER    ' frost bomb: movement frozen this many turns
DIM SHARED siren_turns AS INTEGER    ' magic siren: encounter chance raised while it wails
DIM SHARED die_a AS INTEGER, die_b AS INTEGER    ' last dice shown by RollDiceShow
' DPoly polyhedron die fonts, indexed BY SIDE COUNT: DFONT(20) is the d20 font.
' Loaded from assets/fonts/dpoly by InitDice; 0 = failed to load (falls back to
' the number tumbler). Each glyph IS a die face: 'A'+n draws the solid variant,
' 'a'+n the outline variant -- see DieGlyphCode / DrawFontDie.
DIM SHARED DFONT(1 TO 20) AS LONG
DIM SHARED DFROT AS LONG                          ' scratch image a die renders into, then rotate-blits (tumble spin)
CONST DFROT_W = 160, DFROT_H = 200               ' scratch size (fits a d20 @56pt + headroom for the top vertex)
DIM SHARED last_raw AS INTEGER                    ' last natural dice sum (before modifiers) from DoRoll
DIM SHARED has_key AS INTEGER                     ' player holds the Level Key
DIM SHARED key_level AS INTEGER                   ' which dungeon level (2..9) hides the Level Key this game
DIM SHARED key_room AS INTEGER                    ' the ROOMS() index whose treasure IS the Level Key (Crystal Ball reveals it)
DIM SHARED loiter AS INTEGER                      ' rising danger from lingering (search/idle); triggers wandering monsters
' per-run chronicle for the Legendary Lords: what the champion did on each level
DIM SHARED lvl_kills(1 TO 9) AS INTEGER           ' monsters slain per dungeon level this run
DIM SHARED lvl_gold(1 TO 9) AS LONG               ' gold claimed per dungeon level this run
DIM SHARED lvl_reached(1 TO 9) AS INTEGER         ' levels the champion set foot on this run
DIM SHARED lvl_cleared(1 TO 9) AS INTEGER         ' levels fully cleared this run (reward + level-up once each)
DIM SHARED LORD_DETAIL(1 TO 200) AS STRING        ' raw saved chronicle per loaded lord (parsed on the detail screen)
' Secret doors auto-detected from the board art (bright-blue tiles), hidden until searched.
DIM SHARED SD_X(1 TO 500) AS INTEGER, SD_Y(1 TO 500) AS INTEGER
DIM SHARED SD_FOUND(1 TO 500) AS INTEGER, SD_N AS INTEGER
DIM SHARED FULL_BOARD AS LONG                     ' pristine board (doors + secret rooms visible)
' regular (brown) doors auto-detected from the art; some are flagged "strong" (must be broken)
DIM SHARED DOOR_X(1 TO 800) AS INTEGER, DOOR_Y(1 TO 800) AS INTEGER
DIM SHARED DOOR_STRONG(1 TO 800) AS _BYTE, DOOR_BROKEN(1 TO 800) AS _BYTE, DOOR_N AS INTEGER
DIM SHARED VIS(0 TO 131, 0 TO 60) AS _BYTE        ' 1 = cell currently revealed
' line-of-sight fog-of-war (opt_fov): LIT = in sight now, SEEN = explored (ever seen)
DIM SHARED LOS_LIT(0 TO 131, 0 TO 60) AS _BYTE, LOS_SEEN(0 TO 131, 0 TO 60) AS _BYTE
DIM SHARED fov_cx AS INTEGER, fov_cy AS INTEGER   ' last position FOV was computed from
DIM SHARED DOORCELL(0 TO 131, 0 TO 60) AS _BYTE   ' 1 = a secret-door cell
DIM SHARED SECRET(0 TO 131, 0 TO 60) AS _BYTE     ' 1 = fogged (door-connected sealed cell)
DIM SHARED QX(0 TO 8000) AS INTEGER, QY(0 TO 8000) AS INTEGER   ' flood-fill queue
' settings (toggled from the SETTINGS menu) + the run timer
DIM SHARED opt_music AS INTEGER, opt_sfx AS INTEGER, opt_showdice AS INTEGER, opt_fullscreen AS INTEGER
DIM SHARED opt_voice AS INTEGER                                    ' typewriter text "voice" blips on/off
DIM SHARED opt_musicvol AS INTEGER, opt_sfxvol AS INTEGER, opt_voicevol AS INTEGER  ' 0..10 volume sliders
DIM SHARED opt_realdice AS INTEGER    ' player rolls their own physical dice and types the result
DIM SHARED opt_dicemath AS INTEGER    ' TRUE: player adds modifiers; FALSE: the game adds them
DIM SHARED opt_oldschool AS INTEGER   ' TRUE: Dungeon! 2d6-vs-target combat; FALSE: D&D d20/HP combat
DIM SHARED opt_heroicstats AS INTEGER ' TRUE: roll abilities 4d6-drop-lowest; FALSE: straight 3d6
DIM SHARED opt_boardgame AS INTEGER   ' TRUE: roll dice + step-limited turns; FALSE: free "computer game" movement
DIM SHARED opt_movedice AS INTEGER    ' Boardgame move style: TRUE = roll 1d6 (house variant); FALSE = up to MOVE_MAX, your choice (the DUNGEON! rule)
CONST MOVE_MAX = 5                     ' DUNGEON!: a player moves up to 5 spaces per turn, their choice -- no movement die
DIM SHARED opt_fov AS INTEGER         ' TRUE: line-of-sight fog-of-war (explore the map; start in the first room)
' ---- dice look & feel (all persisted; see DiceColors / DrawFontDie) ----
DIM SHARED opt_dicecolor AS INTEGER   ' 0..5 index into the dice palette (Bone/Blood/Emerald/Sapphire/Gold/Amethyst)
DIM SHARED opt_dicesolid AS INTEGER   ' TRUE: filled die body + contrasting number; FALSE: hollow outline
DIM SHARED opt_d6pips AS INTEGER      ' TRUE: d6 rolls use the hand-drawn pip dice; FALSE: the numbered DPoly d6
DIM SHARED opt_dicespeed AS INTEGER   ' tumble pacing: 0 Slow, 1 Normal, 2 Fast, 3 Instant (see DiceTiming)
DIM SHARED opt_dicelight AS INTEGER   ' 3D dice top-light: 0 Off, 1 Soft, 2 Normal, 3 Strong (ApplyDiceLight)
DIM SHARED opt_diceround AS INTEGER   ' 3D dice edge roundness 0 (sharp) .. 10 (very round); drives cfg.BEVEL
' -- a SEPARATE dice look for the MONSTER's rolls (same options; swapped in around monster rolls) --
DIM SHARED opt_mon_dicecolor AS INTEGER, opt_mon_dicesolid AS INTEGER
DIM SHARED opt_mon_d6pips AS INTEGER, opt_mon_dicespeed AS INTEGER
DIM SHARED sav_dicecolor AS INTEGER, sav_dicesolid AS INTEGER, sav_d6pips AS INTEGER, sav_dicespeed AS INTEGER
' 3D dice: opt_dice3d/opt_mon_dice3d pick 3D (TRUE) vs the font/pip dice (FALSE) for player/monster.
' Push/PopMonsterDice swap opt_dice3d and set dice3d_use_mon so a roll knows which set to draw.
DIM SHARED opt_dice3d AS INTEGER, opt_mon_dice3d AS INTEGER, sav_dice3d AS INTEGER, dice3d_use_mon AS INTEGER
DIM SHARED DICE3D_YOFF AS INTEGER      ' rows to shift the 3D dice tray down (0 default; char-gen pushes it clear of the stat sheet)
DIM SHARED opt_gestures AS INTEGER     ' SETTINGS "Action Gestures": timing-bar mini-game for the second-wind + crit flourish (D&D mode)
DIM SHARED gauge_quality AS SINGLE     ' 0..1 closeness to dead-centre on the last gesture lock
DIM SHARED opt_juice AS INTEGER        ' SETTINGS "Screen Effects": hit-shake, blood/poison splatter, near-death vignette
DIM SHARED FX_BUF AS LONG              ' offscreen snapshot buffer for the screen-shake blit
CONST NBLOOD = 64                      ' fixed blood-grime spatter spots (near-death overlay)
DIM SHARED BLOOD_X(1 TO NBLOOD) AS INTEGER, BLOOD_Y(1 TO NBLOOD) AS INTEGER, BLOOD_R(1 TO NBLOOD) AS INTEGER
CONST NVIG = 10                        ' pre-baked soft RADIAL vignette overlays (a HP-ramp; stretched per frame)
DIM SHARED VIG(0 TO NVIG - 1) AS LONG
CONST BLOOD_ALPHA_MAX = 200            ' near-death blood-grime opacity at full strength (SETTINGS "Blood" scales it)
DIM SHARED opt_bloodstrength AS INTEGER ' SETTINGS "Blood": near-death blood-grime intensity 0 (none) .. 10 (max)
CONST NDRIP = 16                       ' blood drips running down from the top edge (near-death overlay)
DIM SHARED DRIP_X(1 TO NDRIP) AS INTEGER, DRIP_LEN(1 TO NDRIP) AS INTEGER, DRIP_W(1 TO NDRIP) AS INTEGER

' Configurable UI fonts (assets/data/ui-fonts.txt -> LoadUIFonts): a _LOADFONT handle per UI
' region, 0 = keep the built-in 8x16 grid font (CH). Apply with UIFontOn h / UIFontOff.
DIM SHARED UIF_LABEL AS LONG, UIF_MSG AS LONG, UIF_COMBAT AS LONG, UIF_MENU AS LONG, UIF_HUD AS LONG
' which set (1-based index into the dicesets.txt manifest) the player / monster roll
DIM SHARED opt_dice3d_set AS INTEGER, opt_mon_dice3d_set AS INTEGER
DIM SHARED opt_dicefont AS INTEGER    ' which numeral font (1-based index into dicefonts.txt)
DIM SHARED opt_smooth AS INTEGER      ' TRUE: bilinear-smoothed fullscreen; FALSE: crisp pixel-doubled (no dice shimmer)
DIM SHARED opt_combatspeed AS INTEGER ' (legacy, kept for save compat) -- superseded by opt_msgdelay
DIM SHARED opt_msgdelay AS INTEGER    ' auto-advance hold for banner messages: 1..5 seconds, or 0 = wait for a key
DIM SHARED opt_hardcore AS INTEGER    ' TRUE: time passes while idle (no action) -> wandering monsters can find you
DIM SHARED opt_critfumble AS INTEGER  ' TRUE: the crit/fumble effects engine runs (cinematic + bonus/penalty rolls)
DIM SHARED opt_lootrecovery AS INTEGER ' TRUE: death leaves your loot in the room to reclaim (default in D&D mode)
DIM SHARED opt_maxdeaths AS INTEGER    ' lives before permadeath: reach this many deaths and you forfeit (1..9, default 3)
DIM SHARED player_out AS INTEGER       ' set TRUE the moment the active player uses up their last life (PlayGame ends the run)
DIM SHARED run_seed AS DOUBLE          ' the RNG seed the current dungeon was built from (so save/load can reproduce it)
DIM SHARED SVTOK(1 TO 12000) AS STRING, SVTOK_N AS INTEGER, SVTOK_I AS INTEGER   ' save-file token stream
DIM SHARED player_hp AS INTEGER, player_maxhp AS INTEGER   ' D&D mode: adventurer hit points
' old-school 3d6 ability scores (rolled in CREATE A CHARACTER) + the stats derived from them
DIM SHARED player_str AS INTEGER, player_int AS INTEGER, player_wis AS INTEGER
DIM SHARED player_dex AS INTEGER, player_con AS INTEGER, player_cha AS INTEGER
DIM SHARED player_tohit AS INTEGER, player_ac AS INTEGER    ' final to-hit / AC after ability mods
DIM SHARED player_dmgdie AS INTEGER, player_dmgbonus AS INTEGER  ' weapon die + STR/INT damage mod
DIM SHARED music_handle AS LONG                  ' currently-looping menu/level music (for live volume)
' -- per-level in-game music (data-driven; assets/music/playlist.txt; see MUSIC.bas) --
DIM SHARED MUSIC_FILE(1 TO 9) AS STRING          ' music file assigned to each dungeon level (in assets/music/)
DIM SHARED music_level AS INTEGER                ' the level whose track is loaded right now (0 = none)
DIM SHARED music_curfile AS STRING               ' the file currently loaded (so same-file levels don't restart it)
' -- optional file-based sound effects (assets/sfx/<name>.ogg|mp3|wav|flac; see MUSIC.bas) --
' If a file exists for an Sfx name it plays instead of the tone beeper; otherwise the beeper is used.
DIM SHARED SFX_NAME(1 TO 48) AS STRING, SFX_HND(1 TO 48) AS LONG, SFX_N AS INTEGER
DIM SHARED game_start AS DOUBLE                   ' TIMER at play start (elapsed-time display)
DIM SHARED player_name AS STRING                  ' champion name (Legendary Lords / save)
DIM SHARED dbg_on AS INTEGER, moves_made AS INTEGER   ' [~] debug overlay + move counter

' ---- CHRONICLE: per-run stats + a single-line event log (Game Summary / Event Log / Bestiary
'      / Treasury / Lords viewers). Reset by ChronicleReset at the start of each run. ----
DIM SHARED g_rooms_explored AS INTEGER, g_monsters_slain AS INTEGER, g_treasures_found AS INTEGER
DIM SHARED g_items_looted AS INTEGER, g_levels_completed AS INTEGER, g_secrets_found AS INTEGER
DIM SHARED g_crits AS INTEGER, g_fumbles AS INTEGER, g_wander_enc AS INTEGER, g_run_deaths AS INTEGER
DIM SHARED g_gold_found AS LONG, g_secret_tries AS INTEGER
CONST MAXEVLOG = 600
REDIM SHARED EVLOG(1 TO MAXEVLOG) AS STRING
DIM SHARED EVLOG_N AS INTEGER
' per-monster + per-treasure tallies for the Bestiary / Treasury (indexed by a name list)
CONST MAXBEAST = 48, MAXTRE = 64
REDIM SHARED BEAST_NAME(1 TO MAXBEAST) AS STRING
REDIM SHARED BEAST_ENC(1 TO MAXBEAST) AS INTEGER, BEAST_SLAIN(1 TO MAXBEAST) AS INTEGER
REDIM SHARED BEAST_FLED(1 TO MAXBEAST) AS INTEGER, BEAST_KILLEDBY(1 TO MAXBEAST) AS INTEGER
REDIM SHARED BEAST_LOOTED(1 TO MAXBEAST) AS INTEGER
DIM SHARED BEAST_N AS INTEGER
REDIM SHARED TRE_STATNAME(1 TO MAXTRE) AS STRING
REDIM SHARED TRE_FOUND(1 TO MAXTRE) AS INTEGER, TRE_GP(1 TO MAXTRE) AS LONG
DIM SHARED TRE_STAT_N AS INTEGER
