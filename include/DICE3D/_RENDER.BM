$INCLUDEONCE
''
' DICE3D - Software 3D renderer.
'
' Per die: rotate model vertices by the die's orientation, project
' orthographically into the box buffer (positions map 1:1 to the top-down box;
' height PZ lifts the die up-screen), painter-sort the triangles far->near, and
' texture each with 2D _MAPTRIANGLE from the die's face atlas.
'
' Convexity means painter's order alone is correct - no z-buffer needed.
'
' @author Rick Christy <grymmjack@gmail.com>

' Hardware present: render every die via 3D _MAPTRIANGLE onto the OpenGL layer (native
' resolution, hardware-filtered = smooth), over whatever the caller drew on the software
' screen. The atlas is copied to a hardware image once (DICE3D_HWATLAS), reused each frame.
SUB dice3d_present_hw (cfg AS DICE3D_CONFIG)
    DIM AS INTEGER i, lo, hi
    lo = LBOUND(DICE3D_DICE): hi = UBOUND(DICE3D_DICE)
    IF DICE3D_HWATLAS = 0 THEN
        IF hi >= lo THEN
            IF DICE3D_DICE(lo).ATLAS <> 0 THEN DICE3D_HWATLAS = _COPYIMAGE(DICE3D_DICE(lo).ATLAS, 33)
        END IF
    END IF
    FOR i = lo TO hi
        dice3d_render_die_hw DICE3D_DICE(i), cfg
    NEXT
    _DISPLAY
END SUB

' Render one die as textured 3D triangles on the GL layer. Same view transform as the
' software renderer (yaw/tilt), but instead of projecting to 2D we hand the GPU 3D coords
' and let it project + perspective-correct + bilinear-filter. Painter-sorted (no depth
' buffer) so translucent (crystal) bodies keep their look. Box-pixel positions map to GPU
' units via DICE3D_HW_PXK; the die scales by DICE3D_HW_S; the tray sits at (CX,CY,Z).
SUB dice3d_render_die_hw (di AS DICE3D_DIE, cfg AS DICE3D_CONFIG)
    IF di.SIDES <= 0 THEN EXIT SUB
    IF di.FADE <= 0 THEN EXIT SUB
    IF DICE3D_HWATLAS = 0 THEN EXIT SUB
    DIM AS INTEGER i, t, a, b, cc, j, ti, fi, uoff
    DIM AS SINGLE cosT, sinT, cosY, sinY, xx, yy, zz, gx, gy, gz, ds
    DIM rv AS DICE3D_VEC3
    REDIM shlev(0 TO DICE3D_NF - 1) AS INTEGER
    REDIM AS SINGLE X(0 TO DICE3D_NV - 1), Y(0 TO DICE3D_NV - 1), Z(0 TO DICE3D_NV - 1), VZ(0 TO DICE3D_NV - 1)
    cosT = COS(cfg.CAM_TILT * 0.0174532925): sinT = SIN(cfg.CAM_TILT * 0.0174532925)
    cosY = COS(cfg.CAM_YAW * 0.0174532925): sinY = SIN(cfg.CAM_YAW * 0.0174532925)
    gx = DICE3D_HW_CX + (di.PX - cfg.BOX_W * 0.5) * DICE3D_HW_PXK
    gy = DICE3D_HW_CY - (di.PY - di.PZ - cfg.BOX_H * 0.5) * DICE3D_HW_PXK
    gz = DICE3D_HW_Z
    ' A dropped die fades via di.FADE, but _SETALPHA is invalid on a hardware (GL) texture
    ' -- so shrink the die toward its centre as it "fades" instead. Full size at FADE = 1.
    ds = DICE3D_HW_S
    IF di.FADE < 1 THEN ds = DICE3D_HW_S * di.FADE
    FOR i = 0 TO DICE3D_NV - 1
        dice3d_qrot di.Q, DICE3D_MV(i), rv
        xx = rv.X * cosY + rv.Z * sinY
        zz = -rv.X * sinY + rv.Z * cosY
        yy = rv.Y * cosT + zz * sinT
        zz = zz * cosT - rv.Y * sinT
        X(i) = gx + xx * ds: Y(i) = gy + yy * ds: Z(i) = gz + zz * ds
        VZ(i) = zz
    NEXT
    REDIM AS INTEGER ord(0 TO DICE3D_NT - 1)
    REDIM AS SINGLE az(0 TO DICE3D_NT - 1)
    FOR t = 0 TO DICE3D_NT - 1: ord(t) = t: az(t) = (VZ(DICE3D_TA(t)) + VZ(DICE3D_TB(t)) + VZ(DICE3D_TC(t))) / 3: NEXT
    FOR i = 1 TO DICE3D_NT - 1
        ti = ord(i): j = i - 1
        DO WHILE j >= 0
            IF az(ord(j)) <= az(ti) THEN EXIT DO
            ord(j + 1) = ord(j): j = j - 1
        LOOP
        ord(j + 1) = ti
    NEXT
    '--- directional light: per-TRIANGLE brightness-column level (view-space Lambert) so bevel
    '    arcs shade with a smooth gradient across each rounded edge ---
    FOR i = 0 TO DICE3D_NT - 1
        t = ord(i)
        a = DICE3D_TA(t): b = DICE3D_TB(t): cc = DICE3D_TC(t)
        uoff = dice3d_tri_shade_level%(di, cfg, a, b, cc, cosT, sinT, cosY, sinY) * DICE3D_TILE
        _MAPTRIANGLE (DICE3D_TUX(t, 0) + uoff, DICE3D_TUY(t, 0))-(DICE3D_TUX(t, 1) + uoff, DICE3D_TUY(t, 1))-(DICE3D_TUX(t, 2) + uoff, DICE3D_TUY(t, 2)), DICE3D_HWATLAS TO(X(a), Y(a), Z(a))-(X(b), Y(b), Z(b))-(X(cc), Y(cc), Z(cc)), , _SMOOTH
    NEXT

    ' --- read-face highlight: a warm sheen on the winning face so the value it shows is
    '     obvious (light catching the face that's read). Only when it faces the camera. ---
    IF di.VALUE >= LBOUND(DICE3D_VAL2FACE) AND di.VALUE <= UBOUND(DICE3D_VAL2FACE) THEN
        DIM wf AS INTEGER, wnn AS DICE3D_VEC3, nzz AS SINGLE, nz AS SINGLE
        wf = DICE3D_VAL2FACE(di.VALUE)
        IF wf >= 0 AND wf < DICE3D_NF THEN
            dice3d_qrot di.Q, DICE3D_FACE_N(wf), wnn
            nzz = -wnn.X * sinY + wnn.Z * cosY
            nz = nzz * cosT - wnn.Y * sinT
            IF nz > 0.05 THEN
                IF DICE3D_HL = 0 THEN DICE3D_HL = dice3d_hl_image&
                FOR i = 0 TO DICE3D_NT - 1
                    t = ord(i)
                    IF DICE3D_TFACE(t) = wf THEN
                        a = DICE3D_TA(t): b = DICE3D_TB(t): cc = DICE3D_TC(t)
                        _MAPTRIANGLE (0, 0)-(0, 7)-(7, 7), DICE3D_HL TO(X(a), Y(a), Z(a))-(X(b), Y(b), Z(b))-(X(cc), Y(cc), Z(cc)), , _SMOOTH
                    END IF
                NEXT
            END IF
        END IF
    END IF
END SUB

' An 8x8 warm-white tile with baked alpha, copied to a hardware image, for the read-face
' sheen (_SETALPHA is invalid on hardware textures, so the alpha is baked in first).
FUNCTION dice3d_hl_image& ()
    DIM soft AS LONG, hw AS LONG, od AS LONG
    soft = _NEWIMAGE(8, 8, 32)
    od = _DEST: _DEST soft
    LINE (0, 0)-(7, 7), _RGBA32(255, 236, 140, 150), BF
    _DEST od
    hw = _COPYIMAGE(soft, 33)
    _FREEIMAGE soft
    dice3d_hl_image& = hw
END FUNCTION

' View-space Lambert shade for ONE TRIANGLE (its own geometric normal) -> an atlas brightness-
' COLUMN level (0 = full bright, NLEV-1 = darkest). Per-triangle (not per-face) so the subdivided
' bevel arcs each catch light at their own angle -> a smooth gradient across a rounded edge. The
' light (cfg.LIGHT_*) is transformed like the normals (yaw then tilt) so it stays fixed overhead.
FUNCTION dice3d_tri_shade_level% (di AS DICE3D_DIE, cfg AS DICE3D_CONFIG, a AS INTEGER, b AS INTEGER, c AS INTEGER, cosT AS SINGLE, sinT AS SINGLE, cosY AS SINGLE, sinY AS SINGLE)
    DIM AS DICE3D_VEC3 e1, e2, nrm, wn
    DIM AS SINGLE nx, ny, nz, nz0, d, dark, lx, ly, lz, ll, cxx, cyy, czz
    DIM lev AS INTEGER
    IF cfg.LIGHT_ENABLED = 0 THEN dice3d_tri_shade_level% = 0: EXIT FUNCTION
    dice3d_vsub DICE3D_MV(b), DICE3D_MV(a), e1
    dice3d_vsub DICE3D_MV(c), DICE3D_MV(a), e2
    dice3d_vcross e1, e2, nrm
    IF dice3d_vlen(nrm) < 0.00001 THEN dice3d_tri_shade_level% = 0: EXIT FUNCTION
    dice3d_vnorm nrm, nrm
    '--- die is centred at the origin, so flip any inward-facing normal outward ---
    cxx = (DICE3D_MV(a).X + DICE3D_MV(b).X + DICE3D_MV(c).X) / 3
    cyy = (DICE3D_MV(a).Y + DICE3D_MV(b).Y + DICE3D_MV(c).Y) / 3
    czz = (DICE3D_MV(a).Z + DICE3D_MV(b).Z + DICE3D_MV(c).Z) / 3
    IF nrm.X * cxx + nrm.Y * cyy + nrm.Z * czz < 0 THEN nrm.X = -nrm.X: nrm.Y = -nrm.Y: nrm.Z = -nrm.Z
    dice3d_qrot di.Q, nrm, wn
    nx = wn.X * cosY + wn.Z * sinY
    nz0 = -wn.X * sinY + wn.Z * cosY
    ny = wn.Y * cosT + nz0 * sinT
    nz = nz0 * cosT - wn.Y * sinT
    lx = cfg.LIGHT_X: ly = cfg.LIGHT_Y: lz = cfg.LIGHT_Z
    ll = SQR(lx * lx + ly * ly + lz * lz): IF ll < 0.0001 THEN ll = 1
    d = (nx * lx + ny * ly + nz * lz) / ll
    IF d < 0 THEN d = 0
    dark = (1 - cfg.LIGHT_AMBIENT) * (1 - d) * cfg.LIGHT_INTENSITY * di.FADE
    lev = INT(dark / DICE3D_LIGHT_MAXDARK * (DICE3D_LIGHT_NLEV - 1) + 0.5)
    IF lev < 0 THEN lev = 0
    IF lev > DICE3D_LIGHT_NLEV - 1 THEN lev = DICE3D_LIGHT_NLEV - 1
    dice3d_tri_shade_level% = lev
END FUNCTION


SUB dice3d_render_die (di AS DICE3D_DIE, cfg AS DICE3D_CONFIG)
    IF di.SIDES <= 0 THEN EXIT SUB
    IF di.FADE <= 0 THEN EXIT SUB

    DIM AS INTEGER i, t, a, b, c, j, ti, fi, uoff
    DIM AS SINGLE scl, cosT, sinT, cosY, sinY, yy, zz, xx, camd, persp
    DIM rv AS DICE3D_VEC3
    REDIM shlev(0 TO DICE3D_NF - 1) AS INTEGER
    REDIM AS SINGLE xs(0 TO DICE3D_NV - 1), ys(0 TO DICE3D_NV - 1), zs(0 TO DICE3D_NV - 1)

    scl = cfg.DIE_SIZE
    '--- exploding dropped dice swell as they fade ---
    IF di.DROPPED AND cfg.DROP_FX = DICE3D_DROPFX_EXPLODE THEN scl = scl * (1 + di.DROP_T * 1.8)
    cosT = COS(cfg.CAM_TILT * 0.0174532925): sinT = SIN(cfg.CAM_TILT * 0.0174532925)
    cosY = COS(cfg.CAM_YAW * 0.0174532925): sinY = SIN(cfg.CAM_YAW * 0.0174532925)
    camd = 0
    IF cfg.FOV > 0.5 THEN
        camd = 1 / TAN(cfg.FOV * 0.5 * 0.0174532925)
        IF camd < 1.25 THEN camd = 1.25 '   keep camera outside the die
    END IF
    persp = 1
    FOR i = 0 TO DICE3D_NV - 1
        dice3d_qrot di.Q, DICE3D_MV(i), rv
        '--- orbit: yaw about Y, then pitch about X ---
        xx = rv.X * cosY + rv.Z * sinY
        zz = -rv.X * sinY + rv.Z * cosY
        yy = rv.Y * cosT + zz * sinT
        zz = zz * cosT - rv.Y * sinT
        IF camd > 0 THEN persp = camd / (camd - zz) '  perspective foreshorten
        xs(i) = di.PX + xx * persp * scl
        ys(i) = di.PY - yy * persp * scl - di.PZ '   screen Y grows down; +Y up; PZ lifts
        zs(i) = zz '                          view depth for painter sort
    NEXT

    '--- painter sort triangle indices by average depth (ascending = far first) ---
    REDIM AS INTEGER ord(0 TO DICE3D_NT - 1)
    REDIM AS SINGLE az(0 TO DICE3D_NT - 1)
    FOR t = 0 TO DICE3D_NT - 1
        ord(t) = t
        az(t) = (zs(DICE3D_TA(t)) + zs(DICE3D_TB(t)) + zs(DICE3D_TC(t))) / 3
    NEXT
    FOR i = 1 TO DICE3D_NT - 1
        ti = ord(i): j = i - 1
        DO WHILE j >= 0
            IF az(ord(j)) <= az(ti) THEN EXIT DO
            ord(j + 1) = ord(j): j = j - 1
        LOOP
        ord(j + 1) = ti
    NEXT

    '--- FADE < 1 dims the whole die via the atlas alpha (drop FX) ---
    IF di.FADE < 1 THEN _SETALPHA INT(di.FADE * 255), , di.ATLAS
    '--- per-TRIANGLE brightness-column level (smooth gradient across rounded bevel arcs) ---
    FOR i = 0 TO DICE3D_NT - 1
        t = ord(i)
        a = DICE3D_TA(t): b = DICE3D_TB(t): c = DICE3D_TC(t)
        uoff = dice3d_tri_shade_level%(di, cfg, a, b, c, cosT, sinT, cosY, sinY) * DICE3D_TILE
        _MAPTRIANGLE (DICE3D_TUX(t, 0) + uoff, DICE3D_TUY(t, 0))-(DICE3D_TUX(t, 1) + uoff, DICE3D_TUY(t, 1))-(DICE3D_TUX(t, 2) + uoff, DICE3D_TUY(t, 2)), di.ATLAS TO(xs(a), ys(a))-(xs(b), ys(b))-(xs(c), ys(c)), DICE3D_BOXBUF, _SMOOTH
    NEXT
    IF di.FADE < 1 THEN _SETALPHA 255, , di.ATLAS

    '--- read-face highlight: warm sheen on the winning face (matches the hardware path) ---
    IF di.VALUE >= LBOUND(DICE3D_VAL2FACE) AND di.VALUE <= UBOUND(DICE3D_VAL2FACE) AND di.FADE > 0 THEN
        DIM hlf AS INTEGER, hnn AS DICE3D_VEC3, hnz AS SINGLE
        hlf = DICE3D_VAL2FACE(di.VALUE)
        IF hlf >= 0 AND hlf < DICE3D_NF THEN
            dice3d_qrot di.Q, DICE3D_FACE_N(hlf), hnn
            hnz = (-hnn.X * sinY + hnn.Z * cosY) * cosT - hnn.Y * sinT
            IF hnz > 0.05 THEN
                IF DICE3D_HL_SW = 0 THEN
                    DICE3D_HL_SW = _NEWIMAGE(8, 8, 32)
                    DIM od2 AS LONG: od2 = _DEST: _DEST DICE3D_HL_SW
                    LINE (0, 0)-(7, 7), _RGBA32(255, 236, 140, 150), BF
                    _DEST od2
                END IF
                FOR i = 0 TO DICE3D_NT - 1
                    t = ord(i)
                    IF DICE3D_TFACE(t) = hlf THEN
                        a = DICE3D_TA(t): b = DICE3D_TB(t): c = DICE3D_TC(t)
                        _MAPTRIANGLE (0, 0)-(0, 7)-(7, 7), DICE3D_HL_SW TO(xs(a), ys(a))-(xs(b), ys(b))-(xs(c), ys(c)), DICE3D_BOXBUF, _SMOOTH
                    END IF
                NEXT
            END IF
        END IF
    END IF

    '--- wireframe overlay: outline each front-facing face polygon ---
    IF cfg.WIRE_ENABLED AND di.FADE > 0 THEN
        DIM AS INTEGER wf, wp, va, vb
        DIM wnn AS DICE3D_VEC3
        DIM wc AS _UNSIGNED LONG
        DIM AS SINGLE nz, nzz
        wc = _RGBA32(_RED32(cfg.WIRE_KOLOR), _GREEN32(cfg.WIRE_KOLOR), _BLUE32(cfg.WIRE_KOLOR), INT(cfg.WIRE_OPACITY * di.FADE * 255))
        FOR wf = 0 TO DICE3D_NF - 1
            dice3d_qrot di.Q, DICE3D_FACE_N(wf), wnn
            nzz = -wnn.X * sinY + wnn.Z * cosY
            nz = nzz * cosT - wnn.Y * sinT
            IF nz > 0.03 THEN '            front-facing
                FOR wp = 0 TO DICE3D_FVN(wf) - 1
                    va = DICE3D_FVIDX(wf, wp)
                    vb = DICE3D_FVIDX(wf, (wp + 1) MOD DICE3D_FVN(wf))
                    LINE (xs(va), ys(va))-(xs(vb), ys(vb)), wc
                NEXT
            END IF
        NEXT
    END IF
END SUB

''
' Composite one frame: clear the box buffer, draw all dice, draw the outline,
' then blit the buffer over the caller's screen and present.
SUB dice3d_present (cfg AS DICE3D_CONFIG)
    DIM AS LONG od
    DIM AS INTEGER i
    IF DICE3D_HW THEN dice3d_present_hw cfg: EXIT SUB   ' hardware / OpenGL path (native-res, smooth)
    od = _DEST
    _DEST DICE3D_BOXBUF
    IF cfg.BOX_SHOW_BACK THEN
        CLS , cfg.BOX_BACK_KOLOR
    ELSE
        CLS , _RGBA32(0, 0, 0, 0)
    END IF
    FOR i = LBOUND(DICE3D_DICE) TO UBOUND(DICE3D_DICE)
        dice3d_render_die DICE3D_DICE(i), cfg
    NEXT
    IF cfg.BOX_SHOW_OUTLINE THEN LINE (0, 0)-(cfg.BOX_W - 1, cfg.BOX_H - 1), cfg.BOX_OUTLINE_KOLOR, B
    _DEST od
    IF DICE3D_SSDIV > 1 THEN
        '--- supersample AA: smooth-downscale the box buffer to 1/SSDIV via two
        '    textured triangles (bilinear _SMOOTH), instead of a 1:1 nearest blit ---
        DIM AS INTEGER sw, sh, dw, dh, dx, dy
        sw = cfg.BOX_W: sh = cfg.BOX_H
        dw = sw \ DICE3D_SSDIV: dh = sh \ DICE3D_SSDIV
        dx = cfg.BOX_X: dy = cfg.BOX_Y
        _MAPTRIANGLE (0, 0)-(0, sh - 1)-(sw - 1, sh - 1), DICE3D_BOXBUF TO(dx, dy)-(dx, dy + dh - 1)-(dx + dw - 1, dy + dh - 1), od, _SMOOTH
        _MAPTRIANGLE (0, 0)-(sw - 1, sh - 1)-(sw - 1, 0), DICE3D_BOXBUF TO(dx, dy)-(dx + dw - 1, dy + dh - 1)-(dx + dw - 1, dy), od, _SMOOTH
    ELSE
        _PUTIMAGE (cfg.BOX_X, cfg.BOX_Y), DICE3D_BOXBUF, od
    END IF
    _DISPLAY

    '--- optional frame capture (off unless DICE3D_SHOT_EVERY > 0) ---
    DICE3D_FRAME = DICE3D_FRAME + 1
    IF DICE3D_SHOT_EVERY > 0 THEN
        IF DICE3D_FRAME MOD DICE3D_SHOT_EVERY = 0 THEN
            _SAVEIMAGE DICE3D_SHOT_DIR + "/f" + RIGHT$("0000" + LTRIM$(STR$(DICE3D_FRAME)), 4) + ".png", DICE3D_BOXBUF
        END IF
    END IF
END SUB
